        "organizations": {
          "target": "com.gcp.playcustomapp_v1#OrganizationList",
          "traits": {
            "smithy.api#documentation": "Organizations to which the custom app should be made available. If the request contains any organizations, then the app will be restricted to only these organizations. To support the organization linked to the developer account, the organization ID should be provided explicitly together with other organizations. If no organizations are provided, then the app is only available to the organization linked to the developer account."
          }
        },
        "packageName": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Package name of the created Android app. Only present in the API response."
          }
        },
        "title": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Title for the Android app."
          }
        },
        "languageCode": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Default listing language in BCP 47 format."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "This resource represents a custom app."
      }
    },
