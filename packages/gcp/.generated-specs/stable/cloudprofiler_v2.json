        "profileType": {
          "target": "com.gcp.cloudprofiler_v2#CreateProfileRequestProfileTypeItemEnumList",
          "traits": {
            "smithy.api#documentation": "One or more profile types that the agent is capable of providing."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "CreateProfileRequest describes a profile resource online creation request. The deployment field must be populated. The profile_type specifies the list of profile types supported by the agent. The creation call will hang until a profile of one of these types needs to be collected. "
      }
