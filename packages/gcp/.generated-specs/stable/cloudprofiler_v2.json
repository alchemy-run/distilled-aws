  "shapes": {
    "com.gcp.cloudprofiler_v2#Profile": {
      "type": "structure",
      "members": {
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Opaque, server-assigned, unique ID for this profile."
          }
        },
        "profileBytes": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Input only. Profile bytes, as a gzip compressed serialized proto, the format is https://github.com/google/pprof/blob/master/proto/profile.proto."
          }
        },
        "profileType": {
          "target": "com.gcp.cloudprofiler_v2#ProfileProfileTypeEnum",
          "traits": {
            "smithy.api#documentation": "Type of profile. For offline mode, this must be specified when creating the profile. For online mode it is assigned and returned by the server."
          }
        },
        "duration": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Duration of the profiling session. Input (for the offline mode) or output (for the online mode). The field represents requested profiling duration. It may slightly differ from the effective profiling duration, which is recorded in the profile data, in case the profiling can't be stopped immediately (e.g. in case stopping the profiling is handled asynchronously)."
          }
        },
        "startTime": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Start time for the profile. This output is only present in response from the ListProfiles method."
          }
        },
        "labels": {
          "target": "com.gcp.cloudprofiler_v2#StringMap",
          "traits": {
            "smithy.api#documentation": "Input only. Labels associated to this specific profile. These labels will get merged with the deployment labels for the final data set. See documentation on deployment labels for validation rules and limits."
          }
        },
        "deployment": {
          "target": "com.gcp.cloudprofiler_v2#Deployment",
          "traits": {
            "smithy.api#documentation": "Deployment this profile corresponds to."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Profile resource."
      }
    },
