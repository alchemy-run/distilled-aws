          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Field mask used to specify the fields to be overwritten. Currently only profile_bytes and labels fields are supported by UpdateProfile, so only those fields can be specified in the mask. When no mask is provided, all fields are overwritten.",
            "smithy.api#httpQuery": "updateMask"
          }
        },
        "body": {
