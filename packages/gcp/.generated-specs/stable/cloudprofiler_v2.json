    "com.gcp.cloudprofiler_v2#Deployment": {
      "type": "structure",
      "members": {
        "target": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Target is the service name used to group related deployments: * Service name for App Engine Flex / Standard. * Cluster and container name for GKE. * User-specified string for direct Compute Engine profiling (e.g. Java). * Job name for Dataflow. Validation regex: `^[a-z0-9]([-a-z0-9_.]{0,253}[a-z0-9])?$`."
          }
        },
        "projectId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Project ID is the ID of a cloud project. Validation regex: `^a-z{4,61}[a-z0-9]$`."
          }
        },
        "labels": {
          "target": "com.gcp.cloudprofiler_v2#StringMap",
          "traits": {
            "smithy.api#documentation": "Labels identify the deployment within the user universe and same target. Validation regex for label names: `^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$`. Value for an individual label must be <= 512 bytes, the total size of all label names and values must be <= 1024 bytes. Label named \"language\" can be used to record the programming language of the profiled deployment. The standard choices for the value include \"java\", \"go\", \"python\", \"ruby\", \"nodejs\", \"php\", \"dotnet\". For deployments running on Google Cloud Platform, \"zone\" or \"region\" label should be present describing the deployment location. An example of a zone is \"us-central1-a\", an example of a region is \"us-central1\" or \"us-central\"."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Deployment contains the deployment identification information."
      }
    },
    "com.gcp.cloudprofiler_v2#ListProfilesResponse": {
      "type": "structure",
      "members": {
        "skippedProfiles": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Number of profiles that were skipped in the current page since they were not able to be fetched successfully. This should typically be zero. A non-zero value may indicate a transient failure, in which case if the number is too high for your use case, the call may be retried."
          }
        },
        "nextPageToken": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Token to receive the next page of results. This field maybe empty if there are no more profiles to fetch."
          }
        },
        "profiles": {
          "target": "com.gcp.cloudprofiler_v2#ProfileList",
          "traits": {
            "smithy.api#documentation": "List of profiles fetched."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "ListProfileResponse contains the list of collected profiles for deployments in projects which the user has permissions to view."
      }
    },
