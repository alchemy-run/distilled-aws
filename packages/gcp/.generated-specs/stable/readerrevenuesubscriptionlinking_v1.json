  "shapes": {
    "com.gcp.readerrevenuesubscriptionlinking_v1#Entitlement": {
      "type": "structure",
      "members": {
        "subscriptionToken": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "A source-specific subscription token. This is an opaque string that the publisher provides to Google. This token is opaque and has no meaning to Google."
          }
        },
        "detail": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The detail field can carry a description of the SKU that corresponds to what the user has been granted access to. This description, which is opaque to Google, can be displayed in the Google user subscription console for users who linked the subscription to a Google Account. Max 80 character limit."
          }
        },
        "expireTime": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. Expiration time of the entitlement. If unset, the entitlement does not expire (indefinite entitlement). We need to support indefinite entitlements for platform publishers. dd: go/rrm-sl-notedotcom Entitlements that have expired over 30 days will be purged."
          }
        },
        "productId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Required. The publication's product ID that the user has access to. This is the same product ID as can be found in Schema.org markup (http://schema.org/productID). E.g. \"dailybugle.com:basic\""
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "A single entitlement for a publication reader"
      }
    },
    "com.gcp.readerrevenuesubscriptionlinking_v1#Reader": {
      "type": "structure",
      "members": {
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The resource name of the reader. The last part of ppid in the resource name is the publisher provided id."
          }
        },
        "ppid": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The publisher provided id of the reader."
          }
        },
        "createTime": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Time the publication reader was created and associated with a Google user."
          }
        },
        "publicationId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The SwG publication id that the reader has linked their subscription to."
          }
        },
        "originatingPublicationId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The SwG publication id that the reader's subscription linking was originating from."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "A reader of a publication."
      }
    },
