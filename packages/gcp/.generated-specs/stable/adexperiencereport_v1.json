{
  "smithy": "2.0",
  "metadata": {
    "service": "adexperiencereport",
    "version": "v1",
    "title": "Ad Experience Report API",
    "baseUrl": "https://adexperiencereport.googleapis.com/",
    "distilled.finalized": true
  },
  "shapes": {
    "com.gcp.adexperiencereport_v1#PlatformSummary": {
      "type": "structure",
      "members": {
        "lastChangeTime": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The time at which the site's status last changed on this platform."
          }
        },
        "enforcementTime": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The time at which [enforcement](https://support.google.com/webtools/answer/7308033) against the site began or will begin on this platform. Not set when the filter_status is OFF."
          }
        },
        "region": {
          "target": "com.gcp.adexperiencereport_v1#PlatformSummaryRegionItemEnumList",
          "traits": {
            "smithy.api#documentation": "The site's regions on this platform. No longer populated, because there is no longer any semantic difference between sites in different regions."
          }
        },
        "filterStatus": {
          "target": "com.gcp.adexperiencereport_v1#PlatformSummaryFilterStatusEnum",
          "traits": {
            "smithy.api#documentation": "The site's [enforcement status](https://support.google.com/webtools/answer/7308033) on this platform."
          }
        },
        "reportUrl": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "A link to the full Ad Experience Report for the site on this platform.. Not set in ViolatingSitesResponse. Note that you must complete the [Search Console verification process](https://support.google.com/webmasters/answer/9008080) for the site before you can access the full report."
          }
        },
        "underReview": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Whether the site is currently under review on this platform."
          }
        },
        "betterAdsStatus": {
          "target": "com.gcp.adexperiencereport_v1#PlatformSummaryBetterAdsStatusEnum",
          "traits": {
            "smithy.api#documentation": "The site's Ad Experience Report status on this platform."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "A site's Ad Experience Report summary on a single platform."
      }
    },
