      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "v1/violatingSites"
        },
        "smithy.api#documentation": "Lists sites that are failing in the Ad Experience Report on at least one platform."
      }
    },
    "com.gcp.adexperiencereport_v1#GetSitesRequest": {
      "type": "structure",
      "members": {
