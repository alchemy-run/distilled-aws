  "shapes": {
    "com.gcp.verifiedaccess_v2#VerifyChallengeResponseRequest": {
      "type": "structure",
      "members": {
        "challengeResponse": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Required. The generated response to the challenge, the bytes representation of SignedData."
          }
        },
        "expectedIdentity": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. Service can optionally provide identity information about the device or user associated with the key. For an EMK, this value is the enrolled domain. For an EUK, this value is the user's email address. If present, this value will be checked against contents of the response, and verification will fail if there is no match."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Signed ChallengeResponse."
      }
    },
    "com.gcp.verifiedaccess_v2#CrowdStrikeAgent": {
      "type": "structure",
      "members": {
        "agentId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The Agent ID of the Crowdstrike agent."
          }
        },
        "customerId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The Customer ID to which the agent belongs to."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Properties of the CrowdStrike agent installed on a device."
      }
    },
    "com.gcp.verifiedaccess_v2#VerifyChallengeResponseResult": {
      "type": "structure",
      "members": {
        "deviceSignals": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignals",
          "traits": {
            "smithy.api#documentation": "Output only. Device signals."
          }
        },
        "signedPublicKeyAndChallenge": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Certificate Signing Request (in the SPKAC format, base64 encoded) is returned in this field. This field will be set only if device has included CSR in its challenge response. (the option to include CSR is now available for both user and machine responses)"
          }
        },
        "virtualProfileId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The client-provided ID of a profile on the device."
          }
        },
        "profileCustomerId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Unique customer id that this profile belongs to, as defined by the Google Admin SDK at https://developers.google.com/admin-sdk/directory/v1/guides/manage-customers"
          }
        },
        "keyTrustLevel": {
          "target": "com.gcp.verifiedaccess_v2#VerifyChallengeResponseResultKeyTrustLevelEnum",
          "traits": {
            "smithy.api#documentation": "Output only. Device attested key trust level."
          }
        },
        "devicePermanentId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Device permanent id is returned in this field (for the machine response only)."
          }
        },
        "attestedDeviceId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Attested device ID (ADID)."
          }
        },
        "profileKeyTrustLevel": {
          "target": "com.gcp.verifiedaccess_v2#VerifyChallengeResponseResultProfileKeyTrustLevelEnum",
          "traits": {
            "smithy.api#documentation": "Output only. Profile attested key trust level."
          }
        },
        "profilePermanentId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The unique server-side ID of a profile on the device."
          }
        },
        "customerId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Unique customer id that this device belongs to, as defined by the Google Admin SDK at https://developers.google.com/admin-sdk/directory/v1/guides/manage-customers"
          }
        },
        "deviceEnrollmentId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Device enrollment id for ChromeOS devices."
          }
        },
        "virtualDeviceId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Virtual device id of the device. The definition of virtual device id is platform-specific."
          }
        },
        "deviceSignal": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Deprecated. Device signal in json string representation. Prefer using `device_signals` instead."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Result message for VerifiedAccess.VerifyChallengeResponse. The response returned when successful for Managed profiles on Unmanaged browsers will NOT have devicePermanentId, keyTrustLevel, virtualDeviceId and customerId fields. Managed profiles will INSTEAD have the profileCustomerId, virtualProfileId, profilePermanentId and profileKeyTrustLevel fields."
      }
    },
