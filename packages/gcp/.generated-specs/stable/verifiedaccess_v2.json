    "com.gcp.verifiedaccess_v2#DeviceSignals": {
      "type": "structure",
      "members": {
        "operatingSystem": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsOperatingSystemEnum",
          "traits": {
            "smithy.api#documentation": "Output only. The type of the Operating System currently running on the device."
          }
        },
        "screenLockSecured": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsScreenLockSecuredEnum",
          "traits": {
            "smithy.api#documentation": "Output only. The state of the Screen Lock password protection. On ChromeOS, this value will always be ENABLED as there is not way to disable requiring a password or pin when unlocking the device."
          }
        },
        "windowsMachineDomain": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Windows domain that the current machine has joined. Available on Windows only."
          }
        },
        "browserVersion": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Current version of the Chrome browser which generated this set of signals. Example value: \"107.0.5286.0\"."
          }
        },
        "systemDnsServers": {
          "target": "com.gcp.verifiedaccess_v2#StringList",
          "traits": {
            "smithy.api#documentation": "List of the addesses of all OS level DNS servers configured in the device's network settings."
          }
        },
        "osFirewall": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsOsFirewallEnum",
          "traits": {
            "smithy.api#documentation": "Output only. The state of the OS level firewall. On ChromeOS, the value will always be ENABLED on regular devices and UNKNOWN on devices in developer mode. Support for MacOS 15 (Sequoia) and later has been introduced in Chrome M131."
          }
        },
        "profileAffiliationIds": {
          "target": "com.gcp.verifiedaccess_v2#StringList",
          "traits": {
            "smithy.api#documentation": "Output only. Affiliation IDs of the organizations that are affiliated with the organization that is currently managing the Chrome Profile’s user or ChromeOS user."
          }
        },
        "imei": {
          "target": "com.gcp.verifiedaccess_v2#StringList",
          "traits": {
            "smithy.api#documentation": "Output only. International Mobile Equipment Identity (IMEI) of the device. Available on ChromeOS only."
          }
        },
        "osVersion": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The current version of the Operating System. On Windows and linux, the value will also include the security patch information."
          }
        },
        "hostname": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Hostname of the device."
          }
        },
        "macAddresses": {
          "target": "com.gcp.verifiedaccess_v2#StringList",
          "traits": {
            "smithy.api#documentation": "Output only. MAC addresses of the device."
          }
        },
        "secureBootMode": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsSecureBootModeEnum",
          "traits": {
            "smithy.api#documentation": "Output only. Whether the device's startup software has its Secure Boot feature enabled. Available on Windows only."
          }
        },
        "windowsUserDomain": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Windows domain for the current OS user. Available on Windows only."
          }
        },
        "passwordProtectionWarningTrigger": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsPasswordProtectionWarningTriggerEnum",
          "traits": {
            "smithy.api#documentation": "Output only. Whether the Password Protection Warning feature is enabled or not. Password protection alerts users when they reuse their protected password on potentially suspicious sites. This setting is controlled by an enterprise policy: https://chromeenterprise.google/policies/#PasswordProtectionWarningTrigger. Note that the policy unset does not have the same effects as having the policy explicitly set to `PASSWORD_PROTECTION_OFF`."
          }
        },
        "profileEnrollmentDomain": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Enrollment domain of the customer which is currently managing the profile."
          }
        },
        "deviceModel": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The name of the device's model."
          }
        },
        "trigger": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsTriggerEnum",
          "traits": {
            "smithy.api#documentation": "Output only. The trigger which generated this set of signals."
          }
        },
        "realtimeUrlCheckMode": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsRealtimeUrlCheckModeEnum",
          "traits": {
            "smithy.api#documentation": "Output only. Whether Enterprise-grade (i.e. custom) unsafe URL scanning is enabled or not. This setting may be controlled by an enterprise policy: https://chromeenterprise.google/policies/#EnterpriseRealTimeUrlCheckMode"
          }
        },
        "allowScreenLock": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Output only. Value of the AllowScreenLock policy on the device. See https://chromeenterprise.google/policies/?policy=AllowScreenLock for more details. Available on ChromeOS only."
          }
        },
        "deviceAffiliationIds": {
          "target": "com.gcp.verifiedaccess_v2#StringList",
          "traits": {
            "smithy.api#documentation": "Output only. Affiliation IDs of the organizations that are affiliated with the organization that is currently managing the device. When the sets of device and profile affiliation IDs overlap, it means that the organizations managing the device and user are affiliated. To learn more about user affiliation, visit https://support.google.com/chrome/a/answer/12801245?ref_topic=9027936."
          }
        },
        "meid": {
          "target": "com.gcp.verifiedaccess_v2#StringList",
          "traits": {
            "smithy.api#documentation": "Output only. Mobile Equipment Identifier (MEID) of the device. Available on ChromeOS only."
          }
        },
        "deviceManufacturer": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The name of the device's manufacturer."
          }
        },
        "serialNumber": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The serial number of the device. On Windows, this represents the BIOS's serial number. Not available on most Linux distributions."
          }
        },
        "displayName": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The display name of the device, as defined by the user."
          }
        },
        "thirdPartyBlockingEnabled": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Output only. Deprecated. The corresponding policy is now deprecated. Whether Chrome is blocking third-party software injection or not. This setting may be controlled by an enterprise policy: https://chromeenterprise.google/policies/?policy=ThirdPartyBlockingEnabled. Available on Windows only."
          }
        },
        "diskEncryption": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsDiskEncryptionEnum",
          "traits": {
            "smithy.api#documentation": "Output only. The encryption state of the disk. On ChromeOS, the main disk is always ENCRYPTED."
          }
        },
        "siteIsolationEnabled": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Output only. Whether the Site Isolation (a.k.a Site Per Process) setting is enabled. That setting may be controlled by an enterprise policy: https://chromeenterprise.google/policies/#SitePerProcess"
          }
        },
        "builtInDnsClientEnabled": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Output only. Whether Chrome's built-in DNS client is used. The OS DNS client is otherwise used. This value may be controlled by an enterprise policy: https://chromeenterprise.google/policies/#BuiltInDnsClientEnabled."
          }
        },
        "chromeRemoteDesktopAppBlocked": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Output only. Whether access to the Chrome Remote Desktop application is blocked via a policy."
          }
        },
        "deviceEnrollmentDomain": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. Enrollment domain of the customer which is currently managing the device."
          }
        },
        "antivirus": {
          "target": "com.gcp.verifiedaccess_v2#Antivirus",
          "traits": {
            "smithy.api#documentation": "Output only. Information about Antivirus software on the device. Available on Windows only."
          }
        },
        "safeBrowsingProtectionLevel": {
          "target": "com.gcp.verifiedaccess_v2#DeviceSignalsSafeBrowsingProtectionLevelEnum",
          "traits": {
            "smithy.api#documentation": "Output only. Safe Browsing Protection Level. That setting may be controlled by an enterprise policy: https://chromeenterprise.google/policies/#SafeBrowsingProtectionLevel."
          }
        },
        "crowdStrikeAgent": {
          "target": "com.gcp.verifiedaccess_v2#CrowdStrikeAgent",
          "traits": {
            "smithy.api#documentation": "Output only. Crowdstrike agent properties installed on the device, if any. Available on Windows and MacOS only."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "The device signals as reported by Chrome. Unless otherwise specified, signals are available on all platforms."
      }
    },
