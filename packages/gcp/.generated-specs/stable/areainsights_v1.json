          "traits": {
            "smithy.api#documentation": "Area as a circle."
          }
        },
        "customArea": {
          "target": "com.gcp.areainsights_v1#CustomArea",
          "traits": {
            "smithy.api#documentation": "Custom area specified by a polygon."
          }
        },
        "region": {
          "target": "com.gcp.areainsights_v1#Region",
          "traits": {
            "smithy.api#documentation": "Area as region."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Location filters. Specifies the area of interest for the insight."
      }
    },
