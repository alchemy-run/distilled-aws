    "com.gcp.areainsights_v1#ComputeInsightsV1": {
      "type": "operation",
      "input": {
        "target": "com.gcp.areainsights_v1#ComputeInsightsV1Request"
      },
      "output": {
        "target": "com.gcp.areainsights_v1#ComputeInsightsResponse"
      },
      "errors": [
        {
          "target": "com.gcp.areainsights_v1#NotFound"
        },
        {
          "target": "com.gcp.areainsights_v1#Forbidden"
        },
        {
          "target": "com.gcp.areainsights_v1#BadRequest"
        },
        {
          "target": "com.gcp.areainsights_v1#Conflict"
        }
      ],
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "v1:computeInsights"
        },
        "smithy.api#documentation": "This method lets you retrieve insights about areas using a variety of filter such as: area, place type, operating status, price level and ratings. Currently \"count\" and \"places\" insights are supported. With \"count\" insights you can answer questions such as \"How many restaurant are located in California that are operational, are inexpensive and have an average rating of at least 4 stars\" (see `insight` enum for more details). With \"places\" insights, you can determine which places match the requested filter. Clients can then use those place resource names to fetch more details about each individual place using the Places API."
      }
