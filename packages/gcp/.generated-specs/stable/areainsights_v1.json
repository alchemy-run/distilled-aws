        "smithy.api#documentation": "Custom Area."
      }
    },
    "com.gcp.areainsights_v1#PlaceInsight": {
      "type": "structure",
      "members": {
        "place": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The unique identifier of the place. This resource name can be used to retrieve details about the place using the [Places API](https://developers.google.com/maps/documentation/places/web-service/reference/rest/v1/places/get)."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Holds information about a place"
      }
    },
