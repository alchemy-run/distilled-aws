    "com.gcp.merchantapi_notifications_v1beta#CreateAccountsNotificationsubscriptions": {
      "type": "operation",
      "input": {
        "target": "com.gcp.merchantapi_notifications_v1beta#CreateAccountsNotificationsubscriptionsRequest"
