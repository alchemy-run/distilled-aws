    "com.gcp.merchantapi_notifications_v1beta#NotificationSubscription": {
      "type": "structure",
      "members": {
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The `name` of the notification configuration. Generated by the Merchant API upon creation of a new `NotificationSubscription`. The `account` represents the merchant ID of the merchant that owns the configuration. Format: `accounts/{account}/notificationsubscriptions/{notification_subscription}`"
          }
        },
        "targetAccount": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The `name` of the account you want to receive notifications for. Format: `accounts/{account}`"
          }
        },
        "registeredEvent": {
          "target": "com.gcp.merchantapi_notifications_v1beta#NotificationSubscriptionRegisteredEventEnum",
          "traits": {
            "smithy.api#documentation": "The event that the merchant wants to be notified about."
          }
        },
        "allManagedAccounts": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "If this value is true, the requesting account is notified of the specified event for all managed accounts (can be subaccounts or other linked accounts) including newly added accounts on a daily basis."
          }
        },
        "callBackUri": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "URL to be used to push the notification to the merchant."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Represents a notification subscription owned by a Merchant account. See [Decode notifications](/merchant/api/guides/accounts/notifications#decode_notifications) for information on how to decode the notification payload and how to interpret its contents."
      }
