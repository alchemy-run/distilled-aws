          }
        },
        "quotaMinuteLimit": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The maximum number of calls allowed per minute for the group."
          }
        },
        "quotaLimit": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The maximum number of calls allowed per day for the group."
