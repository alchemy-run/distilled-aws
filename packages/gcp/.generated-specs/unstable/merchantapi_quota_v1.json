          "target": "com.gcp.merchantapi_quota_v1#MethodDetailsList",
          "traits": {
            "smithy.api#documentation": "Output only. List of all methods group quota applies to."
          }
        },
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Identifier. The resource name of the quota group. Format: accounts/{account}/quotas/{group} Note: There is no guarantee on the format of {group}"
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "The group information for methods in the Merchant API. The quota is shared between all methods in the group. Even if none of the methods within the group have usage the information for the group is returned."
