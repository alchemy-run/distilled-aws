    "com.gcp.dfareporting_v3_5#CreativeAssetMetadata": {
      "type": "structure",
      "members": {
        "clickTags": {
          "target": "com.gcp.dfareporting_v3_5#ClickTagList",
          "traits": {
            "smithy.api#documentation": "List of detected click tags for assets. This is a read-only, auto-generated field. This field is empty for a rich media asset."
          }
        },
        "detectedFeatures": {
          "target": "com.gcp.dfareporting_v3_5#CreativeAssetMetadataDetectedFeaturesItemEnumList",
          "traits": {
            "smithy.api#documentation": "List of feature dependencies for the creative asset that are detected by Campaign Manager. Feature dependencies are features that a browser must be able to support in order to render your HTML5 creative correctly. This is a read-only, auto-generated field."
          }
        },
        "timerCustomEvents": {
          "target": "com.gcp.dfareporting_v3_5#CreativeCustomEventList",
          "traits": {
            "smithy.api#documentation": "List of timer events configured for the asset. This is a read-only, auto-generated field and only applicable to a rich media asset."
          }
        },
        "warnedValidationRules": {
          "target": "com.gcp.dfareporting_v3_5#CreativeAssetMetadataWarnedValidationRulesItemEnumList",
          "traits": {
            "smithy.api#documentation": "Rules validated during code generation that generated a warning. This is a read-only, auto-generated field. Possible values are: - \"ADMOB_REFERENCED\" - \"ASSET_FORMAT_UNSUPPORTED_DCM\" - \"ASSET_INVALID\" - \"CLICK_TAG_HARD_CODED\" - \"CLICK_TAG_INVALID\" - \"CLICK_TAG_IN_GWD\" - \"CLICK_TAG_MISSING\" - \"CLICK_TAG_MORE_THAN_ONE\" - \"CLICK_TAG_NON_TOP_LEVEL\" - \"COMPONENT_UNSUPPORTED_DCM\" - \"ENABLER_UNSUPPORTED_METHOD_DCM\" - \"EXTERNAL_FILE_REFERENCED\" - \"FILE_DETAIL_EMPTY\" - \"FILE_TYPE_INVALID\" - \"GWD_PROPERTIES_INVALID\" - \"HTML5_FEATURE_UNSUPPORTED\" - \"LINKED_FILE_NOT_FOUND\" - \"MAX_FLASH_VERSION_11\" - \"MRAID_REFERENCED\" - \"NOT_SSL_COMPLIANT\" - \"ORPHANED_ASSET\" - \"PRIMARY_HTML_MISSING\" - \"SVG_INVALID\" - \"ZIP_INVALID\" "
          }
        },
        "idDimensionValue": {
          "target": "com.gcp.dfareporting_v3_5#DimensionValue",
          "traits": {
            "smithy.api#documentation": "Dimension value for the numeric ID of the asset. This is a read-only, auto-generated field."
          }
        },
        "assetIdentifier": {
          "target": "com.gcp.dfareporting_v3_5#CreativeAssetId",
          "traits": {
            "smithy.api#documentation": "ID of the creative asset. This is a required field."
          }
        },
        "counterCustomEvents": {
          "target": "com.gcp.dfareporting_v3_5#CreativeCustomEventList",
          "traits": {
            "smithy.api#documentation": "List of counter events configured for the asset. This is a read-only, auto-generated field and only applicable to a rich media asset."
          }
        },
        "exitCustomEvents": {
          "target": "com.gcp.dfareporting_v3_5#CreativeCustomEventList",
          "traits": {
            "smithy.api#documentation": "List of exit events configured for the asset. This is a read-only, auto-generated field and only applicable to a rich media asset."
          }
        },
        "richMedia": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "True if the uploaded asset is a rich media asset. This is a read-only, auto-generated field."
          }
        },
        "kind": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Identifies what kind of resource this is. Value: the fixed string \"dfareporting#creativeAssetMetadata\"."
          }
        },
        "id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Numeric ID of the asset. This is a read-only, auto-generated field."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "CreativeAssets contains properties of a creative asset file which will be uploaded or has already been uploaded. Refer to the creative sample code for how to upload assets and insert a creative."
      }
