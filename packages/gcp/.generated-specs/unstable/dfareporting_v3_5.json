    "com.gcp.dfareporting_v3_5#ClickTag": {
      "type": "structure",
      "members": {
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Parameter name for the specified click tag. For DISPLAY_IMAGE_GALLERY creative assets, this field must match the value of the creative asset's creativeAssetId.name field."
          }
        },
        "eventName": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Advertiser event name associated with the click tag. This field is used by DISPLAY_IMAGE_GALLERY and HTML5_BANNER creatives. Applicable to DISPLAY when the primary asset type is not HTML_IMAGE."
          }
        },
        "clickThroughUrl": {
          "target": "com.gcp.dfareporting_v3_5#CreativeClickThroughUrl",
          "traits": {
            "smithy.api#documentation": "Parameter value for the specified click tag. This field contains a click-through url."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Creative Click Tag."
      }
    },
    "com.gcp.dfareporting_v3_5#CreativeClickThroughUrl": {
      "type": "structure",
      "members": {
        "computedClickThroughUrl": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Read-only convenience field representing the actual URL that will be used for this click-through. The URL is computed as follows: - If landingPageId is specified then that landing page's URL is assigned to this field. - Otherwise, the customClickThroughUrl is assigned to this field. "
          }
        },
        "landingPageId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "ID of the landing page for the click-through URL."
          }
        },
        "customClickThroughUrl": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Custom click-through URL. Applicable if the landingPageId field is left unset."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Click-through URL"
      }
    },
    "com.gcp.dfareporting_v3_5#DimensionValue": {
