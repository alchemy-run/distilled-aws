  "shapes": {
    "com.gcp.merchantapi_ordertracking_v1beta#DateTime": {
      "type": "structure",
      "members": {
        "day": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Day of month. Must be from 1 to 31 and valid for the year and month, or 0 if specifying a datetime without a day."
          }
        },
        "seconds": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Seconds of minutes of the time. Must normally be from 0 to 59, defaults to 0. An API may allow the value 60 if it allows leap-seconds."
          }
        },
        "minutes": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Minutes of hour of day. Must be from 0 to 59, defaults to 0."
          }
        },
        "utcOffset": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "UTC offset. Must be whole seconds, between -18 hours and +18 hours. For example, a UTC offset of -4:00 would be represented as { seconds: -14400 }."
          }
        },
        "month": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Month of year. Must be from 1 to 12, or 0 if specifying a datetime without a month."
          }
        },
        "nanos": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Fractions of seconds in nanoseconds. Must be from 0 to 999,999,999, defaults to 0."
          }
        },
        "timeZone": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#TimeZone",
          "traits": {
            "smithy.api#documentation": "Time zone."
          }
        },
        "year": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Year of date. Must be from 1 to 9999, or 0 if specifying a datetime without a year."
          }
        },
        "hours": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Optional. Hours of day in 24 hour format. Should be from 0 to 23, defaults to 0 (midnight). An API may choose to allow the value \"24:00:00\" for scenarios like business closing time."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Represents civil time (or occasionally physical time). This type can represent a civil time in one of a few possible ways: * When utc_offset is set and time_zone is unset: a civil time on a calendar day with a particular offset from UTC. * When time_zone is set and utc_offset is unset: a civil time on a calendar day in a particular time zone. * When neither time_zone nor utc_offset is set: a civil time on a calendar day in local time. The date is relative to the Proleptic Gregorian Calendar. If year, month, or day are 0, the DateTime is considered not to have a specific year, month, or day respectively. This type may also be used to represent a physical time if all the date and time fields are set and either case of the `time_offset` oneof is set. Consider using `Timestamp` message for physical time instead. If your use case also would like to store the user's timezone, that can be done in another field. This type is more flexible than some applications may want. Make sure to document and validate your application's limitations."
      }
    },
    "com.gcp.merchantapi_ordertracking_v1beta#OrderTrackingSignal": {
      "type": "structure",
      "members": {
        "orderCreatedTime": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#DateTime",
          "traits": {
            "smithy.api#documentation": "Required. The time when the order was created on the businesses side. Include the year and timezone string, if available."
          }
        },
        "customerShippingFee": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#Price",
          "traits": {
            "smithy.api#documentation": "Optional. The shipping fee of the order; this value should be set to zero in the case of free shipping."
          }
        },
        "shippingInfo": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#ShippingInfoList",
          "traits": {
            "smithy.api#documentation": "Required. The shipping information for the order."
          }
        },
        "deliveryPostalCode": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. The delivery postal code, as a continuous string without spaces or dashes, for example \"95016\". This field will be anonymized in returned OrderTrackingSignal creation response."
          }
        },
        "deliveryRegionCode": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. The [CLDR territory code] (http://www.unicode.org/repos/cldr/tags/latest/common/main/en.xml) for the shipping destination."
          }
        },
        "lineItems": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#LineItemDetailsList",
          "traits": {
            "smithy.api#documentation": "Required. Information about line items in the order."
          }
        },
        "orderTrackingSignalId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Output only. The ID that uniquely identifies this order tracking signal."
          }
        },
        "orderId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Required. The ID of the order on the businesses side. This field will be hashed in returned OrderTrackingSignal creation response."
          }
        },
        "shipmentLineItemMapping": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#ShipmentLineItemMappingList",
          "traits": {
            "smithy.api#documentation": "Optional. The mapping of the line items to the shipment information."
          }
        },
        "merchantId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. The Google Merchant Center ID of this order tracking signal. This value is optional. If left unset, the caller's Merchant Center ID is used. You must request access in order to provide data on behalf of another business. For more information, see [Submitting Order Tracking Signals](/shopping-content/guides/order-tracking-signals)."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Represents a business trade from which signals are extracted, such as shipping."
      }
    },
