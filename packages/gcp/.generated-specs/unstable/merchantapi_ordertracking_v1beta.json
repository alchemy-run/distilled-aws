    "com.gcp.merchantapi_ordertracking_v1beta#ShippingInfo": {
      "type": "structure",
      "members": {
        "carrier": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. The name of the shipping carrier for the delivery. This field is required if one of the following fields is absent: earliest_delivery_promise_time, latest_delivery_promise_time, and actual_delivery_time."
          }
        },
        "earliestDeliveryPromiseTime": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#DateTime",
          "traits": {
            "smithy.api#documentation": "Optional. The earliest delivery promised time. Include the year and timezone string, if available. This field is required, if one of the following fields is absent: tracking_id or carrier_name."
          }
        },
        "shipmentId": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Required. The shipment ID. This field will be hashed in returned OrderTrackingSignal creation response."
          }
        },
        "latestDeliveryPromiseTime": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#DateTime",
          "traits": {
            "smithy.api#documentation": "Optional. The latest delivery promised time. Include the year and timezone string, if available. This field is required, if one of the following fields is absent: tracking_id or carrier_name."
          }
        },
        "actualDeliveryTime": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#DateTime",
          "traits": {
            "smithy.api#documentation": "Optional. The time when the shipment was actually delivered. Include the year and timezone string, if available. This field is required, if one of the following fields is absent: tracking_id or carrier_name."
          }
        },
        "shippingStatus": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#ShippingInfoShippingStatusEnum",
          "traits": {
            "smithy.api#documentation": "Required. The status of the shipment."
