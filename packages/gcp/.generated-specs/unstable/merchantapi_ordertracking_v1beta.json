        "carrierService": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Optional. The service type for fulfillment, such as GROUND, FIRST_CLASS, etc."
          }
        },
        "originRegionCode": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Required. The [CLDR territory code] (http://www.unicode.org/repos/cldr/tags/latest/common/main/en.xml) for the shipping origin."
          }
        },
        "shippedTime": {
          "target": "com.gcp.merchantapi_ordertracking_v1beta#DateTime",
          "traits": {
            "smithy.api#documentation": "Optional. The time when the shipment was shipped. Include the year and timezone string, if available."
          }
