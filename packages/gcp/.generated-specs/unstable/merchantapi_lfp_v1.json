          "traits": {
            "smithy.api#documentation": "Identifier. The name of the `LfpMerchantState` resource. Format: `accounts/{account}/lfpMerchantStates/{target_merchant}`. For example, `accounts/123456/lfpMerchantStates/567890`."
          }
        },
        "storeStates": {
          "target": "com.gcp.merchantapi_lfp_v1#LfpStoreStateList",
          "traits": {
