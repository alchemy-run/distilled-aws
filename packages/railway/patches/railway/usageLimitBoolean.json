{
  "description": "usageLimitSet and usageLimitRemove return Boolean! so the baked documents must not select subfields.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.railway.api#UsageLimitSetRequest/traits/com.railway.graphql#operation/query",
      "value": "mutation usageLimitSet($input: UsageLimitSetInput!) {\n  usageLimitSet(input: $input)\n}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.railway.api#UsageLimitRemoveRequest/traits/com.railway.graphql#operation/query",
      "value": "mutation usageLimitRemove($input: UsageLimitRemoveInput!) {\n  usageLimitRemove(input: $input)\n}"
    }
  ]
}
