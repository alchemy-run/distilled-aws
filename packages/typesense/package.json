{
  "name": "@distilled.cloud/typesense",
  "version": "1.0.0-rc.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/typesense"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./typesense": {
      "types": "./lib/services/typesense.d.ts",
      "bun": "./src/services/typesense.ts",
      "worker": "./src/services/typesense.ts",
      "default": "./lib/services/typesense.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:strict": "tsc -p tsconfig.strict.json"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@effect/platform-bun": "catalog:effect"
  },
  "peerDependencies": {
    "effect": "catalog:effect"
  }
}
