{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    // Same rationale as packages/cloudflare: generated services carry
    // explicit interfaces + `as any as S.Schema<T>` casts, so checking them
    // buys nothing. Hand-written src files are small and vetted by review.
    "noCheck": true,
    "paths": {
      "@distilled.cloud/core/*": ["../core/src/*"]
    }
  },
  "references": [{ "path": "../core" }]
}
