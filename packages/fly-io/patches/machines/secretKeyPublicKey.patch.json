{
  "description": "Wire public_key is a base64 string, not an integer array. Observed on secretkeyGenerate/Get/List.",
  "patches": [
    {
      "op": "replace",
      "path": "/components/schemas/SecretKey/properties/public_key",
      "value": {
        "type": "string"
      }
    },
    {
      "op": "replace",
      "path": "/components/schemas/SetSecretkeyResponse/properties/public_key",
      "value": {
        "type": "string"
      }
    }
  ]
}
