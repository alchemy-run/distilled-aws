{
  "description": "Type Conflict (409) on secretkeySet so already-exists races are catchable.",
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1v1~1apps~1{app_name}~1secretkeys~1{secret_name}/post/responses/409",
      "value": {
        "description": "Conflict"
      }
    }
  ]
}
