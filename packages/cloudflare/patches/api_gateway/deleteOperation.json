{
  "description": "Align api_gateway#OperationsDelete with distilled cloudflare/api-gateway deleteOperation",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.api_gateway#OperationsDelete",
      "path": "/shapes/com.cloudflare.api_gateway#DeleteOperation"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.api_gateway#OperationsDeleteRequest",
      "path": "/shapes/com.cloudflare.api_gateway#DeleteOperationRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.api_gateway#DeleteOperation/input/target",
      "value": "com.cloudflare.api_gateway#DeleteOperationRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.api_gateway#DeleteOperation/errors",
      "value": [
        {
          "target": "com.cloudflare.api_gateway#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.api_gateway#OperationNotFound"
        },
        {
          "target": "com.cloudflare.api_gateway#Forbidden"
        }
      ]
    }
  ]
}
