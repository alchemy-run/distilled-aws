{
  "description": "Align api_gateway#OperationsGet with distilled cloudflare/api-gateway getOperation",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.api_gateway#OperationsGet",
      "path": "/shapes/com.cloudflare.api_gateway#GetOperation"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.api_gateway#OperationsGetRequest",
      "path": "/shapes/com.cloudflare.api_gateway#GetOperationRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.api_gateway#GetOperation/input/target",
      "value": "com.cloudflare.api_gateway#GetOperationRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.api_gateway#OperationsGetResponse",
      "path": "/shapes/com.cloudflare.api_gateway#GetOperationResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.api_gateway#GetOperation/output/target",
      "value": "com.cloudflare.api_gateway#GetOperationResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.api_gateway#GetOperation/errors",
      "value": [
        {
          "target": "com.cloudflare.api_gateway#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.api_gateway#OperationNotFound"
        },
        {
          "target": "com.cloudflare.api_gateway#Forbidden"
        }
      ]
    }
  ]
}
