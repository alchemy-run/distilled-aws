    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.api_gateway#BulkDeleteOperations/input/target",
      "value": "com.cloudflare.api_gateway#BulkDeleteOperationsRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.api_gateway#BulkDeleteOperations/errors",
      "value": [
        {
          "target": "com.cloudflare.api_gateway#InvalidObjectIdentifier"
        }
      ]
    }
  ]
}
