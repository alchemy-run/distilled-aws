{
  "description": "Align addressing#PrefixesDelete with distilled cloudflare/addressing deletePrefix",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesDelete",
      "path": "/shapes/com.cloudflare.addressing#DeletePrefix"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#PrefixesDeleteRequest",
      "path": "/shapes/com.cloudflare.addressing#DeletePrefixRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#DeletePrefix/input/target",
      "value": "com.cloudflare.addressing#DeletePrefixRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#DeletePrefix/errors",
      "value": [
        {
          "target": "com.cloudflare.addressing#MethodNotAllowed"
        },
        {
          "target": "com.cloudflare.addressing#PrefixNotFound"
        },
        {
          "target": "com.cloudflare.addressing#InvalidAccountId"
        }
      ]
    }
  ]
}
