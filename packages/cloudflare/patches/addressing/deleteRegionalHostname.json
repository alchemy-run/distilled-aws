{
  "description": "Align addressing#RegionalHostnamesDelete with distilled cloudflare/addressing deleteRegionalHostname",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#RegionalHostnamesDelete",
      "path": "/shapes/com.cloudflare.addressing#DeleteRegionalHostname"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.addressing#RegionalHostnamesDeleteRequest",
      "path": "/shapes/com.cloudflare.addressing#DeleteRegionalHostnameRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.addressing#DeleteRegionalHostname/input/target",
      "value": "com.cloudflare.addressing#DeleteRegionalHostnameRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.addressing#DeleteRegionalHostname/errors",
      "value": [
        {
          "target": "com.cloudflare.addressing#MethodNotAllowed"
        },
        {
          "target": "com.cloudflare.addressing#InvalidZoneId"
        },
        {
          "target": "com.cloudflare.addressing#RegionalHostnameNotFound"
        },
        {
          "target": "com.cloudflare.addressing#RegionalHostnameEmpty"
        }
      ]
    }
  ]
}
