      "path": "/shapes/com.cloudflare.magic_network_monitoring#CreateConfig"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_network_monitoring#ConfigsCreateRequest",
      "path": "/shapes/com.cloudflare.magic_network_monitoring#CreateConfigRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_network_monitoring#CreateConfig/input/target",
      "value": "com.cloudflare.magic_network_monitoring#CreateConfigRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_network_monitoring#ConfigsCreateResponse",
      "path": "/shapes/com.cloudflare.magic_network_monitoring#CreateConfigResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_network_monitoring#CreateConfig/output/target",
      "value": "com.cloudflare.magic_network_monitoring#CreateConfigResponse"
    },
    {
      "op": "add",
