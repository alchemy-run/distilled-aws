{
  "description": "Align token_validation#RulesList with distilled cloudflare/token-validation listRules",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesList",
      "path": "/shapes/com.cloudflare.token_validation#ListRules"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesListRequest",
      "path": "/shapes/com.cloudflare.token_validation#ListRulesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#ListRules/input/target",
      "value": "com.cloudflare.token_validation#ListRulesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesListResponse",
      "path": "/shapes/com.cloudflare.token_validation#ListRulesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#ListRules/output/target",
      "value": "com.cloudflare.token_validation#ListRulesResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#ListRules/traits/smithy.api#paginated",
      "value": {
        "mode": "page",
        "inputToken": "page",
        "outputToken": "resultInfo.page",
        "items": "result",
        "pageSize": "perPage"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#ListRules/errors",
      "value": [
        {
          "target": "com.cloudflare.token_validation#TokenValidationNotEntitled"
        },
        {
          "target": "com.cloudflare.token_validation#Forbidden"
        }
      ]
    }
  ]
}
