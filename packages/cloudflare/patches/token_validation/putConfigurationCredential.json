{
  "description": "Align token_validation#ConfigurationCredentialsUpdate with distilled cloudflare/token-validation putConfigurationCredential",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#ConfigurationCredentialsUpdate",
      "path": "/shapes/com.cloudflare.token_validation#PutConfigurationCredential"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#ConfigurationCredentialsUpdateRequest",
      "path": "/shapes/com.cloudflare.token_validation#PutConfigurationCredentialRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#PutConfigurationCredential/input/target",
      "value": "com.cloudflare.token_validation#PutConfigurationCredentialRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#ConfigurationCredentialsUpdateResponse",
      "path": "/shapes/com.cloudflare.token_validation#PutConfigurationCredentialResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#PutConfigurationCredential/output/target",
      "value": "com.cloudflare.token_validation#PutConfigurationCredentialResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#PutConfigurationCredential/errors",
      "value": [
        {
          "target": "com.cloudflare.token_validation#TokenConfigurationNotFound"
        },
        {
          "target": "com.cloudflare.token_validation#TokenValidationNotEntitled"
        },
        {
          "target": "com.cloudflare.token_validation#Forbidden"
        }
      ]
    }
  ]
}
