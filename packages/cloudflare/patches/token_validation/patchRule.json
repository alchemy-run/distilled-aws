{
  "description": "Align token_validation#RulesEdit with distilled cloudflare/token-validation patchRule",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesEdit",
      "path": "/shapes/com.cloudflare.token_validation#PatchRule"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesEditRequest",
      "path": "/shapes/com.cloudflare.token_validation#PatchRuleRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#PatchRule/input/target",
      "value": "com.cloudflare.token_validation#PatchRuleRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#RulesEditResponse",
      "path": "/shapes/com.cloudflare.token_validation#PatchRuleResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#PatchRule/output/target",
      "value": "com.cloudflare.token_validation#PatchRuleResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#PatchRule/errors",
      "value": [
        {
          "target": "com.cloudflare.token_validation#TokenValidationRuleNotFound"
        },
        {
          "target": "com.cloudflare.token_validation#TokenValidationNotEntitled"
        },
        {
          "target": "com.cloudflare.token_validation#Forbidden"
        }
      ]
    }
  ]
}
