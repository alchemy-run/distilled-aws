{
  "description": "Align token_validation#ConfigurationEdit with distilled cloudflare/token-validation patchConfiguration",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#ConfigurationEdit",
      "path": "/shapes/com.cloudflare.token_validation#PatchConfiguration"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#ConfigurationEditRequest",
      "path": "/shapes/com.cloudflare.token_validation#PatchConfigurationRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#PatchConfiguration/input/target",
      "value": "com.cloudflare.token_validation#PatchConfigurationRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.token_validation#ConfigurationEditResponse",
      "path": "/shapes/com.cloudflare.token_validation#PatchConfigurationResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.token_validation#PatchConfiguration/output/target",
      "value": "com.cloudflare.token_validation#PatchConfigurationResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.token_validation#PatchConfiguration/errors",
      "value": [
        {
          "target": "com.cloudflare.token_validation#TokenConfigurationNotFound"
        },
        {
          "target": "com.cloudflare.token_validation#TokenValidationNotEntitled"
        },
        {
          "target": "com.cloudflare.token_validation#Forbidden"
        }
      ]
    }
  ]
}
