{
  "description": "Align hyperdrive#ConfigsDelete with distilled cloudflare/hyperdrive deleteConfig",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.hyperdrive#ConfigsDelete",
      "path": "/shapes/com.cloudflare.hyperdrive#DeleteConfig"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.hyperdrive#ConfigsDeleteRequest",
      "path": "/shapes/com.cloudflare.hyperdrive#DeleteConfigRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.hyperdrive#DeleteConfig/input/target",
      "value": "com.cloudflare.hyperdrive#DeleteConfigRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.hyperdrive#ConfigsDeleteResponse",
      "path": "/shapes/com.cloudflare.hyperdrive#DeleteConfigResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.hyperdrive#DeleteConfig/output/target",
      "value": "com.cloudflare.hyperdrive#DeleteConfigResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hyperdrive#DeleteConfig/errors",
      "value": [
        {
          "target": "com.cloudflare.hyperdrive#PrivateHostNotAllowed"
        },
        {
          "target": "com.cloudflare.hyperdrive#HyperdriveConfigNotFound"
        },
        {
          "target": "com.cloudflare.hyperdrive#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.hyperdrive#MethodNotAllowed"
        }
      ]
    }
  ]
}
