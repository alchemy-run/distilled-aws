      "path": "/shapes/com.cloudflare.custom_hostnames#PutCertificatePackCertificateResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.custom_hostnames#PutCertificatePackCertificate/output/target",
      "value": "com.cloudflare.custom_hostnames#PutCertificatePackCertificateResponse"
    }
