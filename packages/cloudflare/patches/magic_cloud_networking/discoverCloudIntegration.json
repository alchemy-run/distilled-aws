{
  "description": "Align magic_cloud_networking#CloudIntegrationsDiscover with distilled cloudflare/magic-cloud-networking discoverCloudIntegration",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_cloud_networking#CloudIntegrationsDiscover",
      "path": "/shapes/com.cloudflare.magic_cloud_networking#DiscoverCloudIntegration"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_cloud_networking#CloudIntegrationsDiscoverRequest",
      "path": "/shapes/com.cloudflare.magic_cloud_networking#DiscoverCloudIntegrationRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_cloud_networking#DiscoverCloudIntegration/input/target",
      "value": "com.cloudflare.magic_cloud_networking#DiscoverCloudIntegrationRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_cloud_networking#DiscoverCloudIntegration/errors",
      "value": [
        {
          "target": "com.cloudflare.magic_cloud_networking#FeatureNotEnabled"
        },
        {
          "target": "com.cloudflare.magic_cloud_networking#Forbidden"
        }
      ]
    }
  ]
}
