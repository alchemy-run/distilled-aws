    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.realtime_kit#RecordingsStartRecordingsResponse",
      "path": "/shapes/com.cloudflare.realtime_kit#StartRecordingsRecordingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.realtime_kit#StartRecordingsRecording/output/target",
