      "value": "com.cloudflare.healthchecks#CreateHealthcheckRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.healthchecks#CreateResponse",
      "path": "/shapes/com.cloudflare.healthchecks#CreateHealthcheckResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.healthchecks#CreateHealthcheck/output/target",
      "value": "com.cloudflare.healthchecks#CreateHealthcheckResponse"
    },
    {
      "op": "add",
