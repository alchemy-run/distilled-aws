{
  "description": "Align acm#CustomTrustStoreDelete with distilled cloudflare/acm deleteCustomTrustStore",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.acm#CustomTrustStoreDelete",
      "path": "/shapes/com.cloudflare.acm#DeleteCustomTrustStore"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.acm#CustomTrustStoreDeleteRequest",
      "path": "/shapes/com.cloudflare.acm#DeleteCustomTrustStoreRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.acm#DeleteCustomTrustStore/input/target",
      "value": "com.cloudflare.acm#DeleteCustomTrustStoreRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.acm#CustomTrustStoreDeleteResponse",
      "path": "/shapes/com.cloudflare.acm#DeleteCustomTrustStoreResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.acm#DeleteCustomTrustStore/output/target",
      "value": "com.cloudflare.acm#DeleteCustomTrustStoreResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.acm#DeleteCustomTrustStore/errors",
      "value": [
        {
          "target": "com.cloudflare.acm#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.acm#AdvancedCertificateManagerRequired"
        },
        {
          "target": "com.cloudflare.acm#CustomTrustStoreNotFound"
        },
        {
          "target": "com.cloudflare.acm#Forbidden"
        }
      ]
    }
  ]
}
