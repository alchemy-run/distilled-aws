{
  "description": "Align pages#ProjectsGet with distilled cloudflare/pages getProject",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.pages#ProjectsGet",
      "path": "/shapes/com.cloudflare.pages#GetProject"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.pages#ProjectsGetRequest",
      "path": "/shapes/com.cloudflare.pages#GetProjectRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.pages#GetProject/input/target",
      "value": "com.cloudflare.pages#GetProjectRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.pages#ProjectsGetResponse",
      "path": "/shapes/com.cloudflare.pages#GetProjectResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.pages#GetProject/output/target",
      "value": "com.cloudflare.pages#GetProjectResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pages#GetProject/errors",
      "value": [
        {
          "target": "com.cloudflare.pages#ProjectNotFound"
        },
        {
          "target": "com.cloudflare.pages#Forbidden"
        }
      ]
    }
  ]
}
