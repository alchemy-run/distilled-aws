{
  "description": "Key dictionary / op aliases for turnstile (mined from distilled)",
  "patches": [
    {
      "op": "add",
      "path": "/metadata/keyDictionary",
      "value": {
        "botFightMode": "bot_fight_mode",
        "clearanceLevel": "clearance_level",
        "createdOn": "created_on",
        "ephemeralId": "ephemeral_id",
        "invalidateImmediately": "invalidate_immediately",
        "modifiedOn": "modified_on",
        "perPage": "per_page",
        "resultInfo": "result_info",
        "totalCount": "total_count"
      }
    }
  ]
}
