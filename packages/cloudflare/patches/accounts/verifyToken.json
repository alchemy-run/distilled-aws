{
  "description": "Align accounts#TokensVerify with distilled cloudflare/accounts verifyToken",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#TokensVerify",
      "path": "/shapes/com.cloudflare.accounts#VerifyToken"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#TokensVerifyRequest",
      "path": "/shapes/com.cloudflare.accounts#VerifyTokenRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#VerifyToken/input/target",
      "value": "com.cloudflare.accounts#VerifyTokenRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#TokensVerifyResponse",
      "path": "/shapes/com.cloudflare.accounts#VerifyTokenResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#VerifyToken/output/target",
      "value": "com.cloudflare.accounts#VerifyTokenResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.accounts#VerifyToken/errors",
      "value": [
        {
          "target": "com.cloudflare.accounts#MissingAuthenticationToken"
        },
        {
          "target": "com.cloudflare.accounts#InvalidRoute"
        }
      ]
    }
  ]
}
