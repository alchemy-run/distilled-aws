{
  "description": "Align accounts#MembersGet with distilled cloudflare/accounts getMember",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#MembersGet",
      "path": "/shapes/com.cloudflare.accounts#GetMember"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#MembersGetRequest",
      "path": "/shapes/com.cloudflare.accounts#GetMemberRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#GetMember/input/target",
      "value": "com.cloudflare.accounts#GetMemberRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#MembersGetResponse",
      "path": "/shapes/com.cloudflare.accounts#GetMemberResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#GetMember/output/target",
      "value": "com.cloudflare.accounts#GetMemberResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.accounts#GetMember/errors",
      "value": [
        {
          "target": "com.cloudflare.accounts#MemberNotFound"
        },
        {
          "target": "com.cloudflare.accounts#InvalidRoute"
        }
      ]
    }
  ]
}
