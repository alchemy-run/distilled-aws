    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.logs#GetReceivedField/input/target",
      "value": "com.cloudflare.logs#GetReceivedFieldRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.logs#ReceivedFieldsGetResponse",
      "path": "/shapes/com.cloudflare.logs#GetReceivedFieldResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.logs#GetReceivedField/output/target",
      "value": "com.cloudflare.logs#GetReceivedFieldResponse"
    }
  ]
}
