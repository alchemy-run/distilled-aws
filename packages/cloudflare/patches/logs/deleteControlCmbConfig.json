      "from": "/shapes/com.cloudflare.logs#ControlCmbConfigDeleteRequest",
      "path": "/shapes/com.cloudflare.logs#DeleteControlCmbConfigRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.logs#DeleteControlCmbConfig/input/target",
      "value": "com.cloudflare.logs#DeleteControlCmbConfigRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.logs#ControlCmbConfigDeleteResponse",
      "path": "/shapes/com.cloudflare.logs#DeleteControlCmbConfigResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.logs#DeleteControlCmbConfig/output/target",
      "value": "com.cloudflare.logs#DeleteControlCmbConfigResponse"
    },
    {
      "op": "add",
