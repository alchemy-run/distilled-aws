{
  "description": "Align registrar#DomainsList with distilled cloudflare/registrar listDomains",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.registrar#DomainsList",
      "path": "/shapes/com.cloudflare.registrar#ListDomains"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.registrar#DomainsListRequest",
      "path": "/shapes/com.cloudflare.registrar#ListDomainsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.registrar#ListDomains/input/target",
      "value": "com.cloudflare.registrar#ListDomainsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.registrar#DomainsListResponse",
      "path": "/shapes/com.cloudflare.registrar#ListDomainsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.registrar#ListDomains/output/target",
      "value": "com.cloudflare.registrar#ListDomainsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.registrar#ListDomains/traits/smithy.api#paginated",
      "value": {
        "mode": "single",
        "items": "result"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.registrar#ListDomains/errors",
      "value": [
        {
          "target": "com.cloudflare.registrar#Forbidden"
        }
      ]
    }
  ]
}
