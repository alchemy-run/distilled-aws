{
  "description": "Align secrets_store#StoresSecretsDuplicate with distilled cloudflare/secrets-store duplicateStoreSecret",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.secrets_store#StoresSecretsDuplicate",
      "path": "/shapes/com.cloudflare.secrets_store#DuplicateStoreSecret"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.secrets_store#StoresSecretsDuplicateRequest",
      "path": "/shapes/com.cloudflare.secrets_store#DuplicateStoreSecretRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.secrets_store#DuplicateStoreSecret/input/target",
      "value": "com.cloudflare.secrets_store#DuplicateStoreSecretRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.secrets_store#StoresSecretsDuplicateResponse",
      "path": "/shapes/com.cloudflare.secrets_store#DuplicateStoreSecretResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.secrets_store#DuplicateStoreSecret/output/target",
      "value": "com.cloudflare.secrets_store#DuplicateStoreSecretResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.secrets_store#DuplicateStoreSecret/errors",
      "value": [
        {
          "target": "com.cloudflare.secrets_store#StoreNotFound"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretNotFound"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretNameEmpty"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretScopesEmpty"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretNameAlreadyExists"
        },
        {
          "target": "com.cloudflare.secrets_store#InvalidAccountId"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretScopeInvalid"
        }
      ]
    }
  ]
}
