{
  "description": "Align secrets_store#StoresSecretsEdit with distilled cloudflare/secrets-store patchStoreSecret",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.secrets_store#StoresSecretsEdit",
      "path": "/shapes/com.cloudflare.secrets_store#PatchStoreSecret"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.secrets_store#StoresSecretsEditRequest",
      "path": "/shapes/com.cloudflare.secrets_store#PatchStoreSecretRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.secrets_store#PatchStoreSecret/input/target",
      "value": "com.cloudflare.secrets_store#PatchStoreSecretRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.secrets_store#StoresSecretsEditResponse",
      "path": "/shapes/com.cloudflare.secrets_store#PatchStoreSecretResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.secrets_store#PatchStoreSecret/output/target",
      "value": "com.cloudflare.secrets_store#PatchStoreSecretResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.secrets_store#PatchStoreSecret/errors",
      "value": [
        {
          "target": "com.cloudflare.secrets_store#StoreNotFound"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretNotFound"
        },
        {
          "target": "com.cloudflare.secrets_store#InvalidAccountId"
        },
        {
          "target": "com.cloudflare.secrets_store#SecretScopeInvalid"
        }
      ]
    }
  ]
}
