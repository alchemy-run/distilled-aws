{
  "description": "Align load_balancers#PoolsGet with distilled cloudflare/load-balancers getPool",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#PoolsGet",
      "path": "/shapes/com.cloudflare.load_balancers#GetPool"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#PoolsGetRequest",
      "path": "/shapes/com.cloudflare.load_balancers#GetPoolRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#GetPool/input/target",
      "value": "com.cloudflare.load_balancers#GetPoolRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#PoolsGetResponse",
      "path": "/shapes/com.cloudflare.load_balancers#GetPoolResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#GetPool/output/target",
      "value": "com.cloudflare.load_balancers#GetPoolResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#GetPool/errors",
      "value": [
        {
          "target": "com.cloudflare.load_balancers#PoolNotFound"
        },
        {
          "target": "com.cloudflare.load_balancers#Forbidden"
        }
      ]
    }
  ]
}
