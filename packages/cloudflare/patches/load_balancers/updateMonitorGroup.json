{
  "description": "Align load_balancers#MonitorGroupsUpdate with distilled cloudflare/load-balancers updateMonitorGroup",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#MonitorGroupsUpdate",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateMonitorGroup"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#MonitorGroupsUpdateRequest",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateMonitorGroupRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateMonitorGroup/input/target",
      "value": "com.cloudflare.load_balancers#UpdateMonitorGroupRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#MonitorGroupsUpdateResponse",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateMonitorGroupResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateMonitorGroup/output/target",
      "value": "com.cloudflare.load_balancers#UpdateMonitorGroupResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateMonitorGroup/errors",
      "value": [
        {
          "target": "com.cloudflare.load_balancers#MonitorGroupNotFound"
        },
        {
          "target": "com.cloudflare.load_balancers#MonitorGroupsNotEnabled"
        },
        {
          "target": "com.cloudflare.load_balancers#Forbidden"
        }
      ]
    }
  ]
}
