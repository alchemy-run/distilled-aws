      "path": "/shapes/com.cloudflare.email_security#ListSubmissions"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SubmissionsListRequest",
      "path": "/shapes/com.cloudflare.email_security#ListSubmissionsRequest"
    },
    {
