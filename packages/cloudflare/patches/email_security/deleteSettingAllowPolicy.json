{
  "description": "Align email_security#SettingsAllowPoliciesDelete with distilled cloudflare/email-security deleteSettingAllowPolicy",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesDelete",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingAllowPolicy"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesDeleteRequest",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingAllowPolicyRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingAllowPolicy/input/target",
      "value": "com.cloudflare.email_security#DeleteSettingAllowPolicyRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesDeleteResponse",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingAllowPolicyResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingAllowPolicy/output/target",
      "value": "com.cloudflare.email_security#DeleteSettingAllowPolicyResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingAllowPolicy/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#AllowPolicyNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
