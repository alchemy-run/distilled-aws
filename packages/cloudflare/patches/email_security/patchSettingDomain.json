{
  "description": "Align email_security#SettingsDomainsEdit with distilled cloudflare/email-security patchSettingDomain",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsDomainsEdit",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingDomain"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsDomainsEditRequest",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingDomainRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingDomain/input/target",
      "value": "com.cloudflare.email_security#PatchSettingDomainRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsDomainsEditResponse",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingDomainResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingDomain/output/target",
      "value": "com.cloudflare.email_security#PatchSettingDomainResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingDomain/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#EmailSecurityDomainNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
