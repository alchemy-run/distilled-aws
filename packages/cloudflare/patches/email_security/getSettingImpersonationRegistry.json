{
  "description": "Align email_security#SettingsImpersonationRegistryGet with distilled cloudflare/email-security getSettingImpersonationRegistry",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryGet",
      "path": "/shapes/com.cloudflare.email_security#GetSettingImpersonationRegistry"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryGetRequest",
      "path": "/shapes/com.cloudflare.email_security#GetSettingImpersonationRegistryRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#GetSettingImpersonationRegistry/input/target",
      "value": "com.cloudflare.email_security#GetSettingImpersonationRegistryRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryGetResponse",
      "path": "/shapes/com.cloudflare.email_security#GetSettingImpersonationRegistryResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#GetSettingImpersonationRegistry/output/target",
      "value": "com.cloudflare.email_security#GetSettingImpersonationRegistryResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#GetSettingImpersonationRegistry/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#ImpersonationRegistryEntryNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
