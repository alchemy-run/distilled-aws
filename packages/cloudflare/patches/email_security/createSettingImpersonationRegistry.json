{
  "description": "Align email_security#SettingsImpersonationRegistryCreate with distilled cloudflare/email-security createSettingImpersonationRegistry",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryCreate",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingImpersonationRegistry"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryCreateRequest",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingImpersonationRegistryRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingImpersonationRegistry/input/target",
      "value": "com.cloudflare.email_security#CreateSettingImpersonationRegistryRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryCreateResponse",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingImpersonationRegistryResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingImpersonationRegistry/output/target",
      "value": "com.cloudflare.email_security#CreateSettingImpersonationRegistryResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingImpersonationRegistry/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
