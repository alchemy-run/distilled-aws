{
  "description": "Align email_security#SettingsBlockSendersCreate with distilled cloudflare/email-security createSettingBlockSender",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsBlockSendersCreate",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingBlockSender"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsBlockSendersCreateRequest",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingBlockSenderRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingBlockSender/input/target",
      "value": "com.cloudflare.email_security#CreateSettingBlockSenderRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsBlockSendersCreateResponse",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingBlockSenderResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingBlockSender/output/target",
      "value": "com.cloudflare.email_security#CreateSettingBlockSenderResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#CreateSettingBlockSender/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
