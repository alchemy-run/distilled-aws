{
  "description": "Align email_security#SettingsDomainsDelete with distilled cloudflare/email-security deleteSettingDomain",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsDomainsDelete",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingDomain"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsDomainsDeleteRequest",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingDomainRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingDomain/input/target",
      "value": "com.cloudflare.email_security#DeleteSettingDomainRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsDomainsDeleteResponse",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingDomainResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingDomain/output/target",
      "value": "com.cloudflare.email_security#DeleteSettingDomainResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingDomain/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#EmailSecurityDomainNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
