{
  "description": "Align email_security#SettingsAllowPoliciesGet with distilled cloudflare/email-security getSettingAllowPolicy",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesGet",
      "path": "/shapes/com.cloudflare.email_security#GetSettingAllowPolicy"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesGetRequest",
      "path": "/shapes/com.cloudflare.email_security#GetSettingAllowPolicyRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#GetSettingAllowPolicy/input/target",
      "value": "com.cloudflare.email_security#GetSettingAllowPolicyRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesGetResponse",
      "path": "/shapes/com.cloudflare.email_security#GetSettingAllowPolicyResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#GetSettingAllowPolicy/output/target",
      "value": "com.cloudflare.email_security#GetSettingAllowPolicyResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#GetSettingAllowPolicy/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#AllowPolicyNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
