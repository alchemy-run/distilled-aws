{
  "description": "Align email_security#SettingsImpersonationRegistryEdit with distilled cloudflare/email-security patchSettingImpersonationRegistry",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryEdit",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingImpersonationRegistry"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryEditRequest",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingImpersonationRegistryRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingImpersonationRegistry/input/target",
      "value": "com.cloudflare.email_security#PatchSettingImpersonationRegistryRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryEditResponse",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingImpersonationRegistryResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingImpersonationRegistry/output/target",
      "value": "com.cloudflare.email_security#PatchSettingImpersonationRegistryResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingImpersonationRegistry/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#ImpersonationRegistryEntryNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
