{
  "description": "Align email_security#SettingsImpersonationRegistryDelete with distilled cloudflare/email-security deleteSettingImpersonationRegistry",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryDelete",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingImpersonationRegistry"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryDeleteRequest",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingImpersonationRegistryRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingImpersonationRegistry/input/target",
      "value": "com.cloudflare.email_security#DeleteSettingImpersonationRegistryRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsImpersonationRegistryDeleteResponse",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingImpersonationRegistryResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingImpersonationRegistry/output/target",
      "value": "com.cloudflare.email_security#DeleteSettingImpersonationRegistryResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingImpersonationRegistry/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#ImpersonationRegistryEntryNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
