{
  "description": "Align email_security#SettingsAllowPoliciesEdit with distilled cloudflare/email-security patchSettingAllowPolicy",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesEdit",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingAllowPolicy"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesEditRequest",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingAllowPolicyRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingAllowPolicy/input/target",
      "value": "com.cloudflare.email_security#PatchSettingAllowPolicyRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsAllowPoliciesEditResponse",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingAllowPolicyResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingAllowPolicy/output/target",
      "value": "com.cloudflare.email_security#PatchSettingAllowPolicyResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#PatchSettingAllowPolicy/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#AllowPolicyNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
