{
  "description": "Align email_security#SettingsTrustedDomainsDelete with distilled cloudflare/email-security deleteSettingTrustedDomain",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsTrustedDomainsDelete",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingTrustedDomain"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsTrustedDomainsDeleteRequest",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingTrustedDomainRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingTrustedDomain/input/target",
      "value": "com.cloudflare.email_security#DeleteSettingTrustedDomainRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_security#SettingsTrustedDomainsDeleteResponse",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingTrustedDomainResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingTrustedDomain/output/target",
      "value": "com.cloudflare.email_security#DeleteSettingTrustedDomainResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_security#DeleteSettingTrustedDomain/errors",
      "value": [
        {
          "target": "com.cloudflare.email_security#TrustedDomainNotFound"
        },
        {
          "target": "com.cloudflare.email_security#EmailSecurityNotEntitled"
        },
        {
          "target": "com.cloudflare.email_security#Forbidden"
        }
      ]
    }
  ]
}
