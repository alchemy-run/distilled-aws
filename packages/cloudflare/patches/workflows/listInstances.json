      "value": {
        "mode": "page",
        "inputToken": "page",
        "outputToken": "resultInfo.page",
        "items": "result",
        "pageSize": "perPage"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workflows#ListInstances/errors",
      "value": [
        {
          "target": "com.cloudflare.workflows#WorkflowNotFound"
        },
        {
          "target": "com.cloudflare.workflows#WorkflowInternalError"
        },
        {
          "target": "com.cloudflare.workflows#InvalidRoute"
        },
        {
          "target": "com.cloudflare.workflows#InvalidBody"
        }
      ]
    }
  ]
}
