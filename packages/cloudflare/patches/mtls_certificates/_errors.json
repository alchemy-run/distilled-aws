{
  "description": "Errors shared by the mtls_certificates operations. Declared once here rather than repeated in every operation's patch file (#421); each operation still lists the ones it returns in its own `errors` array.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.mtls_certificates#CertificateAlreadyDeleted",
      "value": {
        "type": "structure",
