{
  "description": "Align ddos_protection#AdvancedTcpProtectionAllowlistItemsDelete with distilled cloudflare/ddos-protection deleteAdvancedTcpProtectionAllowlistItem",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ddos_protection#AdvancedTcpProtectionAllowlistItemsDelete",
      "path": "/shapes/com.cloudflare.ddos_protection#DeleteAdvancedTcpProtectionAllowlistItem"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ddos_protection#AdvancedTcpProtectionAllowlistItemsDeleteRequest",
      "path": "/shapes/com.cloudflare.ddos_protection#DeleteAdvancedTcpProtectionAllowlistItemRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ddos_protection#DeleteAdvancedTcpProtectionAllowlistItem/input/target",
      "value": "com.cloudflare.ddos_protection#DeleteAdvancedTcpProtectionAllowlistItemRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ddos_protection#DeleteAdvancedTcpProtectionAllowlistItem/errors",
      "value": [
        {
          "target": "com.cloudflare.ddos_protection#AllowlistEntryNotFound"
        },
        {
          "target": "com.cloudflare.ddos_protection#AdvancedTcpProtectionNotEntitled"
        },
        {
          "target": "com.cloudflare.ddos_protection#Forbidden"
        }
      ]
    }
  ]
}
