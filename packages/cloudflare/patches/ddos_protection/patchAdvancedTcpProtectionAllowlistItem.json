      "from": "/shapes/com.cloudflare.ddos_protection#AdvancedTcpProtectionAllowlistItemsEditRequest",
      "path": "/shapes/com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItemRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItem/input/target",
      "value": "com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItemRequest"
    },
    {
      "op": "move",
