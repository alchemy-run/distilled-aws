      "path": "/shapes/com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItemResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItem/output/target",
      "value": "com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItemResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ddos_protection#PatchAdvancedTcpProtectionAllowlistItem/errors",
      "value": [
        {
          "target": "com.cloudflare.ddos_protection#AllowlistEntryNotFound"
        },
        {
          "target": "com.cloudflare.ddos_protection#AdvancedTcpProtectionNotEntitled"
        },
        {
          "target": "com.cloudflare.ddos_protection#Forbidden"
        }
      ]
    }
  ]
}
