{
  "description": "Align resource_sharing#Delete with distilled cloudflare/resource-sharing deleteResourceSharing",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#Delete",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceSharing"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#DeleteRequest",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceSharingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceSharing/input/target",
      "value": "com.cloudflare.resource_sharing#DeleteResourceSharingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#DeleteResponse",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceSharingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceSharing/output/target",
      "value": "com.cloudflare.resource_sharing#DeleteResourceSharingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceSharing/errors",
      "value": [
        {
          "target": "com.cloudflare.resource_sharing#ShareNotFound"
        },
        {
          "target": "com.cloudflare.resource_sharing#Forbidden"
        }
      ]
    }
  ]
}
