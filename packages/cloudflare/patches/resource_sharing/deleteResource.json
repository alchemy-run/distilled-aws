{
  "description": "Align resource_sharing#ResourcesDelete with distilled cloudflare/resource-sharing deleteResource",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#ResourcesDelete",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResource"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#ResourcesDeleteRequest",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResource/input/target",
      "value": "com.cloudflare.resource_sharing#DeleteResourceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#ResourcesDeleteResponse",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResourceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResource/output/target",
      "value": "com.cloudflare.resource_sharing#DeleteResourceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.resource_sharing#DeleteResource/errors",
      "value": [
        {
          "target": "com.cloudflare.resource_sharing#ShareResourceNotFound"
        },
        {
          "target": "com.cloudflare.resource_sharing#Forbidden"
        }
      ]
    }
  ]
}
