{
  "description": "Align resource_sharing#ResourcesUpdate with distilled cloudflare/resource-sharing updateResource",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#ResourcesUpdate",
      "path": "/shapes/com.cloudflare.resource_sharing#UpdateResource"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#ResourcesUpdateRequest",
      "path": "/shapes/com.cloudflare.resource_sharing#UpdateResourceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.resource_sharing#UpdateResource/input/target",
      "value": "com.cloudflare.resource_sharing#UpdateResourceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.resource_sharing#ResourcesUpdateResponse",
      "path": "/shapes/com.cloudflare.resource_sharing#UpdateResourceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.resource_sharing#UpdateResource/output/target",
      "value": "com.cloudflare.resource_sharing#UpdateResourceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.resource_sharing#UpdateResource/errors",
      "value": [
        {
          "target": "com.cloudflare.resource_sharing#ShareResourceNotFound"
        },
        {
          "target": "com.cloudflare.resource_sharing#Forbidden"
        }
      ]
    }
  ]
}
