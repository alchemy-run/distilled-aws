{
  "description": "Align zones#HoldsEdit with distilled cloudflare/zones patchHold",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zones#HoldsEdit",
      "path": "/shapes/com.cloudflare.zones#PatchHold"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zones#HoldsEditRequest",
      "path": "/shapes/com.cloudflare.zones#PatchHoldRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zones#PatchHold/input/target",
      "value": "com.cloudflare.zones#PatchHoldRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zones#HoldsEditResponse",
      "path": "/shapes/com.cloudflare.zones#PatchHoldResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zones#PatchHold/output/target",
      "value": "com.cloudflare.zones#PatchHoldResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zones#PatchHold/errors",
      "value": [
        {
          "target": "com.cloudflare.zones#ZoneHoldNotFound"
        },
        {
          "target": "com.cloudflare.zones#ZoneHoldsRequireEnterprise"
        },
        {
          "target": "com.cloudflare.zones#InvalidZoneIdentifier"
        },
        {
          "target": "com.cloudflare.zones#Forbidden"
        }
      ]
    }
  ]
}
