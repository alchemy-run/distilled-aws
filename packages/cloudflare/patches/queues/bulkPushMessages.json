{
  "description": "Align queues#MessagesBulkPush with distilled cloudflare/queues bulkPushMessages",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#MessagesBulkPush",
      "path": "/shapes/com.cloudflare.queues#BulkPushMessages"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#MessagesBulkPushRequest",
      "path": "/shapes/com.cloudflare.queues#BulkPushMessagesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#BulkPushMessages/input/target",
      "value": "com.cloudflare.queues#BulkPushMessagesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.queues#MessagesBulkPushResponse",
      "path": "/shapes/com.cloudflare.queues#BulkPushMessagesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.queues#BulkPushMessages/output/target",
      "value": "com.cloudflare.queues#BulkPushMessagesResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#BulkPushMessages/errors",
      "value": [
        {
          "target": "com.cloudflare.queues#InvalidMessageBody"
        },
        {
          "target": "com.cloudflare.queues#InvalidQueueId"
        },
        {
          "target": "com.cloudflare.queues#InvalidRoute"
        }
      ]
    }
  ]
}
