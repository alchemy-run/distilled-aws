{
  "description": "Align r2_data_catalog#Disable with distilled cloudflare/r2-data-catalog disableR2DataCatalog",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#Disable",
      "path": "/shapes/com.cloudflare.r2_data_catalog#DisableR2DataCatalog"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#DisableRequest",
      "path": "/shapes/com.cloudflare.r2_data_catalog#DisableR2DataCatalogRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2_data_catalog#DisableR2DataCatalog/input/target",
      "value": "com.cloudflare.r2_data_catalog#DisableR2DataCatalogRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2_data_catalog#DisableR2DataCatalog/errors",
      "value": [
        {
          "target": "com.cloudflare.r2_data_catalog#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2_data_catalog#InvalidRoute"
        },
        {
          "target": "com.cloudflare.r2_data_catalog#WarehouseNotFound"
        },
        {
          "target": "com.cloudflare.r2_data_catalog#Forbidden"
        }
      ]
    }
  ]
}
