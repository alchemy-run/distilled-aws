{
  "description": "Align r2_data_catalog#CredentialsCreate with distilled cloudflare/r2-data-catalog createCredential",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#CredentialsCreate",
      "path": "/shapes/com.cloudflare.r2_data_catalog#CreateCredential"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#CredentialsCreateRequest",
      "path": "/shapes/com.cloudflare.r2_data_catalog#CreateCredentialRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2_data_catalog#CreateCredential/input/target",
      "value": "com.cloudflare.r2_data_catalog#CreateCredentialRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#CredentialsCreateResponse",
      "path": "/shapes/com.cloudflare.r2_data_catalog#CreateCredentialResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2_data_catalog#CreateCredential/output/target",
      "value": "com.cloudflare.r2_data_catalog#CreateCredentialResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2_data_catalog#CreateCredential/errors",
      "value": [
        {
          "target": "com.cloudflare.r2_data_catalog#InvalidRoute"
        },
        {
          "target": "com.cloudflare.r2_data_catalog#InvalidCredential"
        }
      ]
    }
  ]
}
