      "path": "/shapes/com.cloudflare.r2_data_catalog#ListNamespaceTables"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#NamespacesTablesListRequest",
      "path": "/shapes/com.cloudflare.r2_data_catalog#ListNamespaceTablesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2_data_catalog#ListNamespaceTables/input/target",
      "value": "com.cloudflare.r2_data_catalog#ListNamespaceTablesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2_data_catalog#NamespacesTablesListResponse",
      "path": "/shapes/com.cloudflare.r2_data_catalog#ListNamespaceTablesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2_data_catalog#ListNamespaceTables/output/target",
      "value": "com.cloudflare.r2_data_catalog#ListNamespaceTablesResponse"
    },
    {
