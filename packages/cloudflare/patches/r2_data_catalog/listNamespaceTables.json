      "path": "/shapes/com.cloudflare.r2_data_catalog#ListNamespaceTables/errors",
      "value": [
        {
          "target": "com.cloudflare.r2_data_catalog#InvalidRoute"
        },
        {
          "target": "com.cloudflare.r2_data_catalog#WarehouseInactive"
        }
      ]
    }
  ]
