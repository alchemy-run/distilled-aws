      "path": "/shapes/com.cloudflare.images#PatchV1Variant/input/target",
      "value": "com.cloudflare.images#PatchV1VariantRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.images#V1VariantsEditResponse",
      "path": "/shapes/com.cloudflare.images#PatchV1VariantResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.images#PatchV1Variant/output/target",
      "value": "com.cloudflare.images#PatchV1VariantResponse"
    },
    {
      "op": "add",
