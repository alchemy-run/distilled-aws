      "path": "/shapes/com.cloudflare.intel#CreateIndicatorFeedPermissionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.intel#CreateIndicatorFeedPermission/output/target",
      "value": "com.cloudflare.intel#CreateIndicatorFeedPermissionResponse"
    },
    {
      "op": "add",
