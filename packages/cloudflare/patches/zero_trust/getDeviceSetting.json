    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zero_trust#GetDeviceSetting/input/target",
      "value": "com.cloudflare.zero_trust#GetDeviceSettingRequest"
    },
    {
      "op": "move",
