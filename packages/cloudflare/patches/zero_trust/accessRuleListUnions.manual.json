      "path": "/shapes/com.cloudflare.zero_trust#UpdateAccessGroupForAccountRequest/members/require/target",
      "value": "com.cloudflare.zero_trust#AccessGroupsUpdateForAccountRequestIncludeList"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zero_trust#CreateAccessGroupForZoneRequest/members/exclude/target",
