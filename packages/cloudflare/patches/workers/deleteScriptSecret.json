{
  "description": "Align workers#ScriptsSecretsDelete with distilled cloudflare/workers deleteScriptSecret",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsDelete",
      "path": "/shapes/com.cloudflare.workers#DeleteScriptSecret"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsDeleteRequest",
      "path": "/shapes/com.cloudflare.workers#DeleteScriptSecretRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#DeleteScriptSecret/input/target",
      "value": "com.cloudflare.workers#DeleteScriptSecretRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsDeleteResponse",
      "path": "/shapes/com.cloudflare.workers#DeleteScriptSecretResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#DeleteScriptSecret/output/target",
      "value": "com.cloudflare.workers#DeleteScriptSecretResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#DeleteScriptSecret/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#WorkerNotFound"
        },
        {
          "target": "com.cloudflare.workers#SecretNotFound"
        }
      ]
    }
  ]
}
