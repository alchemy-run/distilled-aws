{
  "description": "Align workers#AccountSettingsGet with distilled cloudflare/workers getAccountSetting",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#AccountSettingsGet",
      "path": "/shapes/com.cloudflare.workers#GetAccountSetting"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#AccountSettingsGetRequest",
      "path": "/shapes/com.cloudflare.workers#GetAccountSettingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetAccountSetting/input/target",
      "value": "com.cloudflare.workers#GetAccountSettingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#AccountSettingsGetResponse",
      "path": "/shapes/com.cloudflare.workers#GetAccountSettingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetAccountSetting/output/target",
      "value": "com.cloudflare.workers#GetAccountSettingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#GetAccountSetting/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#InvalidRoute"
        },
        {
          "target": "com.cloudflare.workers#Forbidden"
        }
      ]
    }
  ]
}
