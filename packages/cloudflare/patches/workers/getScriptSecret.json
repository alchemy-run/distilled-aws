      "from": "/shapes/com.cloudflare.workers#ScriptsSecretsGetResponse",
      "path": "/shapes/com.cloudflare.workers#GetScriptSecretResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#GetScriptSecret/output/target",
      "value": "com.cloudflare.workers#GetScriptSecretResponse"
    },
    {
      "op": "add",
