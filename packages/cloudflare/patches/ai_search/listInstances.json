{
  "description": "Align ai_search#InstancesList with distilled cloudflare/aisearch listInstances",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesList",
      "path": "/shapes/com.cloudflare.ai_search#ListInstances"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesListRequest",
      "path": "/shapes/com.cloudflare.ai_search#ListInstancesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_search#ListInstances/input/target",
      "value": "com.cloudflare.ai_search#ListInstancesRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesListResponse",
      "path": "/shapes/com.cloudflare.ai_search#ListInstancesResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_search#ListInstances/output/target",
      "value": "com.cloudflare.ai_search#ListInstancesResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_search#ListInstances/traits/smithy.api#paginated",
      "value": {
        "mode": "page",
        "inputToken": "page",
        "outputToken": "resultInfo.page",
        "items": "result",
        "pageSize": "perPage"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_search#ListInstances/errors",
      "value": [
        {
          "target": "com.cloudflare.ai_search#InvalidRoute"
        },
        {
          "target": "com.cloudflare.ai_search#Forbidden"
        }
      ]
    }
  ]
}
