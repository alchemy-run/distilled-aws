{
  "description": "Align ai_search#InstancesCreate with distilled cloudflare/aisearch createInstance",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesCreate",
      "path": "/shapes/com.cloudflare.ai_search#CreateInstance"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesCreateRequest",
      "path": "/shapes/com.cloudflare.ai_search#CreateInstanceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_search#CreateInstance/input/target",
      "value": "com.cloudflare.ai_search#CreateInstanceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_search#InstancesCreateResponse",
      "path": "/shapes/com.cloudflare.ai_search#CreateInstanceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_search#CreateInstance/output/target",
      "value": "com.cloudflare.ai_search#CreateInstanceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_search#CreateInstance/errors",
      "value": [
        {
          "target": "com.cloudflare.ai_search#ValidationError"
        },
        {
          "target": "com.cloudflare.ai_search#NotFound"
        },
        {
          "target": "com.cloudflare.ai_search#InvalidRoute"
        },
        {
          "target": "com.cloudflare.ai_search#InstanceAlreadyExists"
        },
        {
          "target": "com.cloudflare.ai_search#InvalidTokenCredentials"
        },
        {
          "target": "com.cloudflare.ai_search#Forbidden"
        }
      ]
    }
  ]
}
