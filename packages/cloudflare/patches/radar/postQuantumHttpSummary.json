    {
      "op": "move",
      "from": "/shapes/com.cloudflare.radar#HttpSummaryPostQuantumResponse",
      "path": "/shapes/com.cloudflare.radar#PostQuantumHttpSummaryResponse"
    },
    {
      "op": "replace",
