{
  "description": "Align r2#BucketsDomainsManagedList with distilled cloudflare/r2 listBucketDomainManageds",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsManagedList",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManageds"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsManagedListRequest",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManagedsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManageds/input/target",
      "value": "com.cloudflare.r2#ListBucketDomainManagedsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsManagedListResponse",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManagedsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManageds/output/target",
      "value": "com.cloudflare.r2#ListBucketDomainManagedsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManageds/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidRoute"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#ListBucketDomainManagedsRequest/members/cf_r2_jurisdiction",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainManagedsRequest/members/jurisdiction"
    }
  ]
}
