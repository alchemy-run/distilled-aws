      "path": "/shapes/com.cloudflare.r2#DeleteBucketCorsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#DeleteBucketCors/output/target",
      "value": "com.cloudflare.r2#DeleteBucketCorsResponse"
    },
    {
      "op": "add",
