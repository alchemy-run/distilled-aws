{
  "description": "Align r2#BucketsDomainsCustomList with distilled cloudflare/r2 listBucketDomainCustoms",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsCustomList",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustoms"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsCustomListRequest",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustomsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustoms/input/target",
      "value": "com.cloudflare.r2#ListBucketDomainCustomsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsDomainsCustomListResponse",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustomsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustoms/output/target",
      "value": "com.cloudflare.r2#ListBucketDomainCustomsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustoms/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidRoute"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#ListBucketDomainCustomsRequest/members/cf_r2_jurisdiction",
      "path": "/shapes/com.cloudflare.r2#ListBucketDomainCustomsRequest/members/jurisdiction"
    }
  ]
}
