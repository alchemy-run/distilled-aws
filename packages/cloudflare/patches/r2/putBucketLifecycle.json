{
  "description": "Align r2#BucketsLifecycleUpdate with distilled cloudflare/r2 putBucketLifecycle",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsLifecycleUpdate",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycle"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsLifecycleUpdateRequest",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycleRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycle/input/target",
      "value": "com.cloudflare.r2#PutBucketLifecycleRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsLifecycleUpdateResponse",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycleResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycle/output/target",
      "value": "com.cloudflare.r2#PutBucketLifecycleResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycle/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidRoute"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#PutBucketLifecycleRequest/members/cf_r2_jurisdiction",
      "path": "/shapes/com.cloudflare.r2#PutBucketLifecycleRequest/members/jurisdiction"
    }
  ]
}
