{
  "description": "Align r2#BucketsCorsGet with distilled cloudflare/r2 getBucketCors",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsCorsGet",
      "path": "/shapes/com.cloudflare.r2#GetBucketCors"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsCorsGetRequest",
      "path": "/shapes/com.cloudflare.r2#GetBucketCorsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#GetBucketCors/input/target",
      "value": "com.cloudflare.r2#GetBucketCorsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsCorsGetResponse",
      "path": "/shapes/com.cloudflare.r2#GetBucketCorsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#GetBucketCors/output/target",
      "value": "com.cloudflare.r2#GetBucketCorsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#GetBucketCors/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidRoute"
        },
        {
          "target": "com.cloudflare.r2#NoCorsConfiguration"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#GetBucketCorsRequest/members/cf_r2_jurisdiction",
      "path": "/shapes/com.cloudflare.r2#GetBucketCorsRequest/members/jurisdiction"
    }
  ]
}
