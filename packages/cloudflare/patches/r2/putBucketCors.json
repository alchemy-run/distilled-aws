{
  "description": "Align r2#BucketsCorsUpdate with distilled cloudflare/r2 putBucketCors",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsCorsUpdate",
      "path": "/shapes/com.cloudflare.r2#PutBucketCors"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsCorsUpdateRequest",
      "path": "/shapes/com.cloudflare.r2#PutBucketCorsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#PutBucketCors/input/target",
      "value": "com.cloudflare.r2#PutBucketCorsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsCorsUpdateResponse",
      "path": "/shapes/com.cloudflare.r2#PutBucketCorsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#PutBucketCors/output/target",
      "value": "com.cloudflare.r2#PutBucketCorsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#PutBucketCors/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidRoute"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#PutBucketCorsRequest/members/cf_r2_jurisdiction",
      "path": "/shapes/com.cloudflare.r2#PutBucketCorsRequest/members/jurisdiction"
    }
  ]
}
