{
  "description": "Align r2#BucketsGet with distilled cloudflare/r2 getBucket",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsGet",
      "path": "/shapes/com.cloudflare.r2#GetBucket"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsGetRequest",
      "path": "/shapes/com.cloudflare.r2#GetBucketRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#GetBucket/input/target",
      "value": "com.cloudflare.r2#GetBucketRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#BucketsGetResponse",
      "path": "/shapes/com.cloudflare.r2#GetBucketResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.r2#GetBucket/output/target",
      "value": "com.cloudflare.r2#GetBucketResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#GetBucket/errors",
      "value": [
        {
          "target": "com.cloudflare.r2#NoSuchBucket"
        },
        {
          "target": "com.cloudflare.r2#InvalidRoute"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.r2#GetBucketRequest/members/cf_r2_jurisdiction",
      "path": "/shapes/com.cloudflare.r2#GetBucketRequest/members/jurisdiction"
    }
  ]
}
