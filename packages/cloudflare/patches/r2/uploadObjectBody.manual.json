{
  "description": "putObject: the object IS the request body; content type rides the Content-Type header",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/body",
      "value": {
        "target": "smithy.api#Blob",
        "traits": {
          "smithy.api#httpPayload": {},
          "smithy.api#documentation": "The object content — sent verbatim as the request body."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/content_type",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Content-Type",
          "smithy.api#documentation": "MIME type stored with the object."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObject/traits/smithy.api#http/bodyMediaType",
      "value": "application/octet-stream"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/content_disposition",
