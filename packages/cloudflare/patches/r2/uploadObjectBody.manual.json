      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Cache-Control",
          "smithy.api#documentation": "Cache control directives for the object."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/expires",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Expires",
          "smithy.api#documentation": "Expiration date of the object."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/cf_r2_storage_class",
      "value": {
