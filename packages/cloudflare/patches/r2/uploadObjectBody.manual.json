        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Content-Disposition",
          "smithy.api#documentation": "Content disposition of the object."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/content_encoding",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Content-Encoding",
          "smithy.api#documentation": "Content encoding of the object."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/content_language",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Content-Language",
          "smithy.api#documentation": "Content language of the object."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.r2#UploadBucketObjectRequest/members/content_length",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Content-Length",
          "smithy.api#documentation": "Content length of the object in bytes."
        }
