      "from": "/shapes/com.cloudflare.magic_transit#SitesWansUpdateRequest",
      "path": "/shapes/com.cloudflare.magic_transit#UpdateSiteWanRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_transit#UpdateSiteWan/input/target",
      "value": "com.cloudflare.magic_transit#UpdateSiteWanRequest"
