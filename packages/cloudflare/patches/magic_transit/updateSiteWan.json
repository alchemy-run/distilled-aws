    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#SitesWansUpdateResponse",
      "path": "/shapes/com.cloudflare.magic_transit#UpdateSiteWanResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_transit#UpdateSiteWan/output/target",
      "value": "com.cloudflare.magic_transit#UpdateSiteWanResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#UpdateSiteWan/errors",
      "value": [
        {
