{
  "description": "Align magic_transit#GreTunnelsGet with distilled cloudflare/magic-transit getGreTunnel",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#GreTunnelsGet",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnel"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#GreTunnelsGetRequest",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnelRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnel/input/target",
      "value": "com.cloudflare.magic_transit#GetGreTunnelRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#GreTunnelsGetResponse",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnelResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnel/output/target",
      "value": "com.cloudflare.magic_transit#GetGreTunnelResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnel/errors",
      "value": [
        {
          "target": "com.cloudflare.magic_transit#GreTunnelNotFound"
        },
        {
          "target": "com.cloudflare.magic_transit#MagicTransitNotOnboarded"
        },
        {
          "target": "com.cloudflare.magic_transit#Forbidden"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.magic_transit#GetGreTunnelRequest/members/x_magic_new_hc_target",
      "path": "/shapes/com.cloudflare.magic_transit#GetGreTunnelRequest/members/xMagicNewHcTarget"
    }
  ]
}
