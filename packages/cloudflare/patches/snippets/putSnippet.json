    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.snippets#UpdateResponse",
      "path": "/shapes/com.cloudflare.snippets#PutSnippetResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.snippets#PutSnippet/output/target",
      "value": "com.cloudflare.snippets#PutSnippetResponse"
    }
  ]
}
