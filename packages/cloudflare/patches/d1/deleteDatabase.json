{
  "description": "Align d1#DatabaseDelete with distilled cloudflare/d1 deleteDatabase",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.d1#DatabaseDelete",
      "path": "/shapes/com.cloudflare.d1#DeleteDatabase"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.d1#DatabaseDeleteRequest",
      "path": "/shapes/com.cloudflare.d1#DeleteDatabaseRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.d1#DeleteDatabase/input/target",
      "value": "com.cloudflare.d1#DeleteDatabaseRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.d1#DatabaseDeleteResponse",
      "path": "/shapes/com.cloudflare.d1#DeleteDatabaseResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.d1#DeleteDatabase/output/target",
      "value": "com.cloudflare.d1#DeleteDatabaseResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.d1#DeleteDatabase/errors",
      "value": [
        {
          "target": "com.cloudflare.d1#InvalidObjectIdentifier"
        },
        {
          "target": "com.cloudflare.d1#DatabaseNotFound"
        },
        {
          "target": "com.cloudflare.d1#UnknownError"
        }
      ]
    }
  ]
}
