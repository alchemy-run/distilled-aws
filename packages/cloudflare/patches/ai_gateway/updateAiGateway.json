    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_gateway#UpdateResponse",
      "path": "/shapes/com.cloudflare.ai_gateway#UpdateAiGatewayResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_gateway#UpdateAiGateway/output/target",
      "value": "com.cloudflare.ai_gateway#UpdateAiGatewayResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai_gateway#UpdateAiGateway/errors",
      "value": [
        {
          "target": "com.cloudflare.ai_gateway#GatewayNotFound"
        }
      ]
    }
  ]
