      "from": "/shapes/com.cloudflare.ai_gateway#UpdateRequest",
      "path": "/shapes/com.cloudflare.ai_gateway#UpdateAiGatewayRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_gateway#UpdateAiGateway/input/target",
