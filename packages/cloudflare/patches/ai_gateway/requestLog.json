{
  "description": "Align ai_gateway#LogsRequest with distilled cloudflare/ai-gateway requestLog",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_gateway#LogsRequest",
      "path": "/shapes/com.cloudflare.ai_gateway#RequestLog"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai_gateway#LogsRequestRequest",
      "path": "/shapes/com.cloudflare.ai_gateway#RequestLogRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai_gateway#RequestLog/input/target",
      "value": "com.cloudflare.ai_gateway#RequestLogRequest"
    }
  ]
}
