{
  "description": "Align dns#ZoneTransfersOutgoingUpdate with distilled cloudflare/dns updateZoneTransferOutgoing",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#ZoneTransfersOutgoingUpdate",
      "path": "/shapes/com.cloudflare.dns#UpdateZoneTransferOutgoing"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#ZoneTransfersOutgoingUpdateRequest",
      "path": "/shapes/com.cloudflare.dns#UpdateZoneTransferOutgoingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#UpdateZoneTransferOutgoing/input/target",
      "value": "com.cloudflare.dns#UpdateZoneTransferOutgoingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#ZoneTransfersOutgoingUpdateResponse",
      "path": "/shapes/com.cloudflare.dns#UpdateZoneTransferOutgoingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#UpdateZoneTransferOutgoing/output/target",
      "value": "com.cloudflare.dns#UpdateZoneTransferOutgoingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.dns#UpdateZoneTransferOutgoing/errors",
      "value": [
        {
          "target": "com.cloudflare.dns#OutgoingZoneTransferNotFound"
        },
        {
          "target": "com.cloudflare.dns#OutgoingZoneTransfersNotAllowed"
        }
      ]
    }
  ]
}
