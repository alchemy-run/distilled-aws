      "path": "/shapes/com.cloudflare.dns#GetUsageAccountRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#GetUsageAccount/input/target",
      "value": "com.cloudflare.dns#GetUsageAccountRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#UsageAccountGetResponse",
      "path": "/shapes/com.cloudflare.dns#GetUsageAccountResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#GetUsageAccount/output/target",
      "value": "com.cloudflare.dns#GetUsageAccountResponse"
    }
  ]
}
