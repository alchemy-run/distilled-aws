    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#DeleteZoneTransferPeer/input/target",
      "value": "com.cloudflare.dns#DeleteZoneTransferPeerRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#ZoneTransfersPeersDeleteResponse",
      "path": "/shapes/com.cloudflare.dns#DeleteZoneTransferPeerResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#DeleteZoneTransferPeer/output/target",
      "value": "com.cloudflare.dns#DeleteZoneTransferPeerResponse"
    },
    {
      "op": "add",
