    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#CreateZoneTransferOutgoing/input/target",
      "value": "com.cloudflare.dns#CreateZoneTransferOutgoingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.dns#ZoneTransfersOutgoingCreateResponse",
      "path": "/shapes/com.cloudflare.dns#CreateZoneTransferOutgoingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.dns#CreateZoneTransferOutgoing/output/target",
      "value": "com.cloudflare.dns#CreateZoneTransferOutgoingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.dns#CreateZoneTransferOutgoing/errors",
      "value": [
        {
          "target": "com.cloudflare.dns#OutgoingZoneTransfersNotAllowed"
        }
      ]
    }
  ]
