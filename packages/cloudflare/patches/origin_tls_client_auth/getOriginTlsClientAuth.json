      "from": "/shapes/com.cloudflare.origin_tls_client_auth#Get",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#GetOriginTlsClientAuth"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.origin_tls_client_auth#GetRequest",
