      "path": "/shapes/com.cloudflare.origin_tls_client_auth#GetOriginTlsClientAuth/input/target",
      "value": "com.cloudflare.origin_tls_client_auth#GetOriginTlsClientAuthRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.origin_tls_client_auth#GetResponse",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#GetOriginTlsClientAuthResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.origin_tls_client_auth#GetOriginTlsClientAuth/output/target",
      "value": "com.cloudflare.origin_tls_client_auth#GetOriginTlsClientAuthResponse"
    },
    {
