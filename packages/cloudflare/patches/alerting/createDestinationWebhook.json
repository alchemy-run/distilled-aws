    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhook/input/target",
      "value": "com.cloudflare.alerting#CreateDestinationWebhookRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#DestinationsWebhooksCreateResponse",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhookResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#CreateDestinationWebhook/output/target",
      "value": "com.cloudflare.alerting#CreateDestinationWebhookResponse"
    },
    {
      "op": "add",
