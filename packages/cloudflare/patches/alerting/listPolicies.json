      "from": "/shapes/com.cloudflare.alerting#PoliciesList",
      "path": "/shapes/com.cloudflare.alerting#ListPolicies"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.alerting#PoliciesListRequest",
      "path": "/shapes/com.cloudflare.alerting#ListPoliciesRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.alerting#ListPolicies/input/target",
      "value": "com.cloudflare.alerting#ListPoliciesRequest"
    },
    {
      "op": "move",
