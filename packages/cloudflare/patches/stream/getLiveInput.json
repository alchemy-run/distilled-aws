{
  "description": "Align stream#LiveInputsGet with distilled cloudflare/stream getLiveInput",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.stream#LiveInputsGet",
      "path": "/shapes/com.cloudflare.stream#GetLiveInput"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.stream#LiveInputsGetRequest",
      "path": "/shapes/com.cloudflare.stream#GetLiveInputRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.stream#GetLiveInput/input/target",
      "value": "com.cloudflare.stream#GetLiveInputRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.stream#LiveInputsGetResponse",
      "path": "/shapes/com.cloudflare.stream#GetLiveInputResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.stream#GetLiveInput/output/target",
      "value": "com.cloudflare.stream#GetLiveInputResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.stream#GetLiveInput/errors",
      "value": [
        {
          "target": "com.cloudflare.stream#LiveInputNotFound"
        },
        {
          "target": "com.cloudflare.stream#Forbidden"
        }
      ]
    }
  ]
}
