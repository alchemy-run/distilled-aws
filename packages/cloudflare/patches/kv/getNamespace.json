{
  "description": "Align kv#NamespacesGet with distilled cloudflare/kv getNamespace",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.kv#NamespacesGet",
      "path": "/shapes/com.cloudflare.kv#GetNamespace"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.kv#NamespacesGetRequest",
      "path": "/shapes/com.cloudflare.kv#GetNamespaceRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.kv#GetNamespace/input/target",
      "value": "com.cloudflare.kv#GetNamespaceRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.kv#NamespacesGetResponse",
      "path": "/shapes/com.cloudflare.kv#GetNamespaceResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.kv#GetNamespace/output/target",
      "value": "com.cloudflare.kv#GetNamespaceResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.kv#GetNamespace/errors",
      "value": [
        {
          "target": "com.cloudflare.kv#NamespaceNotFound"
        },
        {
          "target": "com.cloudflare.kv#InvalidObjectIdentifier"
        }
      ]
    }
  ]
}
