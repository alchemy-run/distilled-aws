      }
    },
    "com.cloudflare.protocols#ResultInfo": {
      "type": "structure",
      "members": {
        "page": {
          "target": "smithy.api#Double"
        },
        "per_page": {
          "target": "smithy.api#Double"
        },
        "count": {
          "target": "smithy.api#Double"
        },
        "total_count": {
          "target": "smithy.api#Double"
        }
      }
    }
  }
