    "com.paypal.payment_experience_web_experience_profiles_v1#FlowConfig": {
      "type": "structure",
      "members": {
        "landing_page_type": {
          "target": "com.paypal.payment_experience_web_experience_profiles_v1#FlowConfigLandingPageType",
          "traits": {
            "smithy.api#documentation": "The type of landing page to display on the PayPal site for user checkout. To use the non-PayPal account landing page, set to `Billing`. To use the PayPal account login landing page, set to `Login`."
          }
        },
        "bank_txn_pending_url": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The merchant site URL to display after a bank transfer payment. In Germany, valid only for the Giropay payment method or bank transfer payment method."
          }
        },
        "user_action": {
          "target": "com.paypal.payment_experience_web_experience_profiles_v1#FlowConfigUserAction",
          "traits": {
            "smithy.api#documentation": "Presents either the **Continue** or **Pay Now** checkout flow to the customer.<br/><br/>Default is **Continue**, or `user_action=continue`. When you do not know the final payment amount, accept this default flow, which redirects the customer to the PayPal payment page with the **Continue** button. When the customer clicks **Continue**, the customer can change the payment amount.<br/><br/> When you know the final payment amount, set `user_action=commit` to choose the **Pay Now** flow, which redirects the customer to the PayPal payment page with the **Pay Now** button. When the customer clicks **Pay Now**, the payment is processed immediately."
          }
        },
        "return_uri_http_method": {
          "target": "com.paypal.payment_experience_web_experience_profiles_v1#FlowConfigReturnUriHttpMethod",
          "traits": {
            "smithy.api#documentation": "The HTTP method to use to redirect the customer to a return URL. Value is `GET` or `POST`."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "The flow configuration parameters."
      }
    },
