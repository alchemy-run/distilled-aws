{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    // Generated services carry explicit interfaces + `as any as S.Schema<T>`
    // casts (the compile-perf pattern from distilled PR #360), so checking
    // them buys nothing and costs minutes/GBs.
    "noCheck": true,
    "paths": {
      "@distilled.cloud/core/*": ["../core/src/*"]
    }
  },
  "references": [{ "path": "../core" }]
}
