      }
    },
    "com.posthog.web_analytics#WeeklyDigestResponseGoalsList": {
      "type": "list",
      "member": {
        "target": "com.posthog.web_analytics#Goal"
      },
      "traits": {
        "smithy.api#documentation": "Goal conversions."
      }
    },
    "com.posthog.web_analytics#WebAnalyticsWeeklyDigest": {
      "type": "operation",
      "input": {
        "target": "com.posthog.web_analytics#WebAnalyticsWeeklyDigestRequest"
      },
      "output": {
        "target": "com.posthog.web_analytics#WeeklyDigestResponse"
      },
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/api/projects/{project_id}/web_analytics/weekly_digest/",
          "code": 200
        },
        "smithy.api#documentation": "Summarize web analytics\n\nSummarizes a project's web analytics over a lookback window (default 7 days): unique visitors, pageviews, sessions, bounce rate, and average session duration with period-over-period comparisons, plus the top 5 pages, top 5 traffic sources, and goal conversions."
      }
    },
    "com.posthog.web_analytics#WebAnalytics": {
      "type": "service",
      "version": "1.0.0",
      "operations": [
        {
          "target": "com.posthog.web_analytics#WebAnalyticsRecap"
        },
        {
          "target": "com.posthog.web_analytics#WebAnalyticsWeeklyDigest"
        }
      ],
      "traits": {
        "smithy.api#title": "PostHog API"
      }
    }
  }
