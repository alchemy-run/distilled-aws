        "emoji": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Emoji for the highlight.",
            "smithy.api#required": {}
          }
        },
        "title": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Short headline for the highlight, e.g. 'Rising star page'.",
            "smithy.api#required": {}
          }
        },
        "value": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The standout value, e.g. a page path or visitor count.",
            "smithy.api#required": {}
          }
        },
        "detail": {
          "target": "smithy.api#String",
          "traits": {
