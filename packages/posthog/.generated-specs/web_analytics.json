  "shapes": {
    "com.posthog.web_analytics#WebAnalyticsRecapRequest": {
      "type": "structure",
      "members": {
        "project_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpLabel": {},
            "smithy.api#required": {},
            "smithy.api#documentation": "Project ID of the project you're trying to access. To find the ID of the project, make a call to /api/projects/."
          }
        },
        "compare": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#httpQuery": "compare",
            "smithy.api#documentation": "When true (default), include period-over-period change for each metric comparing against the prior equal-length period. Set to false to skip the comparison query."
          }
        },
        "days": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#httpQuery": "days",
            "smithy.api#documentation": "Lookback window in days (1–90). Defaults to 7."
          }
        }
      },
      "traits": {
        "smithy.api#input": {}
      }
    },
    "com.posthog.web_analytics#WebAnalyticsRecapResponse": {
      "type": "structure",
      "members": {
        "visitors": {
          "target": "com.posthog.web_analytics#NumericMetric",
          "traits": {
            "smithy.api#documentation": "Unique visitors.",
            "smithy.api#required": {}
          }
        },
        "pageviews": {
          "target": "com.posthog.web_analytics#NumericMetric",
          "traits": {
            "smithy.api#documentation": "Total pageviews.",
            "smithy.api#required": {}
          }
        },
        "sessions": {
          "target": "com.posthog.web_analytics#NumericMetric",
          "traits": {
            "smithy.api#documentation": "Total sessions.",
            "smithy.api#required": {}
          }
        },
        "bounce_rate": {
          "target": "com.posthog.web_analytics#NumericMetric",
          "traits": {
            "smithy.api#documentation": "Bounce rate (0–100).",
            "smithy.api#required": {}
          }
        },
        "avg_session_duration": {
          "target": "com.posthog.web_analytics#DurationMetric",
          "traits": {
            "smithy.api#documentation": "Average session duration.",
            "smithy.api#required": {}
          }
        },
        "top_pages": {
          "target": "com.posthog.web_analytics#WebAnalyticsRecapResponseTopPagesList",
          "traits": {
            "smithy.api#documentation": "Top 5 pages by unique visitors.",
            "smithy.api#required": {}
          }
        },
        "top_sources": {
          "target": "com.posthog.web_analytics#WebAnalyticsRecapResponseTopSourcesList",
          "traits": {
            "smithy.api#documentation": "Top 5 traffic sources by unique visitors.",
            "smithy.api#required": {}
          }
        },
        "goals": {
          "target": "com.posthog.web_analytics#WebAnalyticsRecapResponseGoalsList",
          "traits": {
            "smithy.api#documentation": "Goal conversions.",
            "smithy.api#required": {}
          }
        },
        "dashboard_url": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Link to the Web analytics dashboard for this project.",
            "smithy.api#required": {}
          }
        },
        "persona": {
          "target": "com.posthog.web_analytics#RecapPersona",
          "traits": {
            "smithy.api#documentation": "The single weekly persona assigned from this week's data.",
            "smithy.api#required": {}
          }
        },
        "highlights": {
          "target": "com.posthog.web_analytics#WebAnalyticsRecapResponseHighlightsList",
          "traits": {
            "smithy.api#documentation": "Up to three screenshot-worthy superlatives for the week.",
            "smithy.api#required": {}
          }
        },
        "period_label": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Human-readable period label, e.g. 'Last 7 days'.",
            "smithy.api#required": {}
          }
        },
        "period_start": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "First date included in the recap period, in the project timezone.",
            "smithy.api#required": {}
          }
        },
        "period_end": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Final date included in the recap period, in the project timezone.",
            "smithy.api#required": {}
          }
        },
        "project_name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Name of the project this recap is for.",
            "smithy.api#required": {}
          }
        },
        "recap_url": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Canonical link to this project's weekly recap.",
            "smithy.api#required": {}
          }
        }
      },
      "traits": {}
    },
    "com.posthog.web_analytics#NumericMetric": {
      "type": "structure",
      "members": {
        "current": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "Value for the most recent period."
          }
        },
        "previous": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "Value for the prior period, if available.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "change": {
          "target": "com.posthog.web_analytics#WoWChange",
          "traits": {
            "smithy.api#documentation": "Period-over-period change, null when not meaningful.",
            "com.distilled.openapi#nullable": {}
          }
        }
      },
      "traits": {}
    },
    "com.posthog.web_analytics#WoWChange": {
      "type": "structure",
      "members": {
        "percent": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Absolute percentage change, rounded to nearest integer."
          }
        },
        "direction": {
          "target": "com.posthog.web_analytics#WoWChangeDirectionEnum",
          "traits": {
            "smithy.api#documentation": "Direction of the change relative to the prior period.\n\n* `Up` - Up\n* `Down` - Down"
          }
        },
        "color": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Hex color indicating whether the change is a positive or negative signal."
          }
        },
        "text": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Short label, e.g. 'Up 12%'."
          }
        },
        "long_text": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Verbose label, e.g. 'Up 12% from prior period'."
          }
        }
      },
      "traits": {}
    },
    "com.posthog.web_analytics#WoWChangeDirectionEnum": {
      "type": "enum",
      "members": {
        "UP": {
          "target": "smithy.api#Unit",
          "traits": {
            "smithy.api#enumValue": "Up"
          }
        },
        "DOWN": {
          "target": "smithy.api#Unit",
          "traits": {
            "smithy.api#enumValue": "Down"
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "* `Up` - Up\n* `Down` - Down"
      }
    },
