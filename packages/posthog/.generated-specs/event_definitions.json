    "com.posthog.event_definitions#EventDefinitionsBulkUpdateVerifiedCreate": {
      "type": "operation",
      "input": {
        "target": "com.posthog.event_definitions#EventDefinitionsBulkUpdateVerifiedCreateRequest"
      },
      "output": {
        "target": "com.posthog.event_definitions#EventDefinitionBulkUpdateVerifiedResponse"
      },
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/api/projects/{project_id}/event_definitions/bulk_update_verified/",
          "code": 200
        },
        "smithy.api#documentation": "Mark multiple event definitions as verified or unverified in one request.\n\nIn the same vein as ``bulk_update_tags``, but ``verified`` lives on the enterprise\n``EnterpriseEventDefinition`` extension rather than the base row, so this action:\n- requires an enterprise license;\n- scopes by project (``team__project_id``) and relies on project membership — the same\n  boundary the single-object update path uses — rather than object-level RBAC;\n- lazily promotes ingestion-created base rows to ``EnterpriseEventDefinition`` (mirroring\n  ``_get_event_definition``) before setting ``verified``;\n- mirrors the single-object semantics: verifying stamps ``verified_by``/``verified_at`` and\n  unhides the event (an event cannot be both hidden and verified); unverifying clears them;\n- logs a \"changed\" activity per event so the History tab matches the single-object path.\n\nEvents already in the target state are skipped (not re-written, not logged)."
      }
    },
