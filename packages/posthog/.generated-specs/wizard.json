    "com.posthog.wizard#WizardSessionsLatestRetrieve": {
      "type": "operation",
      "input": {
        "target": "com.posthog.wizard#WizardSessionsLatestRetrieveRequest"
      },
      "output": {
        "target": "com.posthog.wizard#WizardSessionDTO"
      },
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/api/projects/{project_id}/wizard/sessions/latest/",
          "code": 200
        },
        "smithy.api#documentation": "Return the single most-recent wizard session for a workflow (and optional skill), or 204 if none exists. Unlike `list`, this is a point lookup the app shell uses to decide whether to open the live SSE stream — it never returns a collection, and 'no run' is a 204 rather than a 404 so clients don't conflate it with a missing endpoint."
      }
    },
    "com.posthog.wizard#WizardSessionsStreamRetrieveRequest": {
      "type": "structure",
      "members": {
        "project_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpLabel": {},
            "smithy.api#required": {},
            "smithy.api#documentation": "Project ID of the project you're trying to access. To find the ID of the project, make a call to /api/projects/."
          }
        },
        "skill_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpQuery": "skill_id"
          }
