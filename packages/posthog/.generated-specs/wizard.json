        "smithy.api#http": {
          "method": "POST",
          "uri": "/api/projects/{project_id}/wizard/sessions/",
          "code": 200
        },
        "smithy.api#documentation": "Upsert a wizard session. The `session_id` key is the idempotency anchor — reposting the same `session_id` replaces the existing row. Returns 201 on create, 200 on update."
      }
    },
