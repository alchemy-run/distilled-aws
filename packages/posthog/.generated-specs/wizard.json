        },
        "run_phase": {
          "target": "com.posthog.wizard#RunPhaseEnum",
          "traits": {
            "smithy.api#documentation": "Lifecycle stage of the wizard run.\n\n* `idle` - IDLE\n* `running` - RUNNING\n* `completed` - COMPLETED\n* `error` - ERROR",
            "smithy.api#required": {}
          }
        },
        "tasks": {
          "target": "com.posthog.wizard#WizardSessionsCreateRequestTasksList",
          "traits": {
            "smithy.api#required": {}
          }
        },
        "event_plan": {
          "target": "com.posthog.wizard#WizardSessionsCreateRequestEventPlanMap",
          "traits": {
            "smithy.api#documentation": "Optional structured plan of events the wizard intends to instrument. Schema is workflow-specific.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "error": {
          "target": "com.posthog.wizard#WizardSessionsCreateRequestErrorMap",
          "traits": {
            "smithy.api#documentation": "Populated when run_phase='error'. Shape: { type: string, message: string }.",
            "com.distilled.openapi#nullable": {}
          }
        }
