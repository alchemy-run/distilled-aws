    "com.posthog.metrics#MetricQueryBody": {
      "type": "structure",
      "members": {
        "metricName": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Exact metric name to query (e.g. 'http.server.duration'). Single-clause shorthand — mutually exclusive with 'clauses'."
          }
        },
        "aggregation": {
          "target": "com.posthog.metrics#AggregationEnum",
          "traits": {
            "smithy.api#documentation": "Aggregation applied per time bucket. 'rate' (per-second) and 'increase' are counter-aware: per-series deltas with Prometheus counter-reset handling, temporality-aware (delta-temporality samples count as-is). 'histogram_quantile' interpolates from OTel histogram buckets and requires 'quantile'.\n\n* `sum` - sum\n* `avg` - avg\n* `count` - count\n* `p95` - p95\n* `rate` - rate\n* `increase` - increase\n* `histogram_quantile` - histogram_quantile"
          }
        },
        "quantile": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "Quantile in (0, 1) for 'histogram_quantile' (e.g. 0.95). Ignored for other aggregations.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "filters": {
          "target": "com.posthog.metrics#MetricQueryBodyFiltersList",
          "traits": {
            "smithy.api#documentation": "Label predicates ANDed together. Rows must satisfy every filter."
          }
        },
        "groupBy": {
          "target": "com.posthog.metrics#MetricQueryBodyGroupByList",
          "traits": {
            "smithy.api#documentation": "Labels to split the result into separate series by. Series share one time grid and are capped at the 100 largest."
          }
        },
        "interval": {
          "target": "com.posthog.metrics#MetricQueryIntervalEnum",
          "traits": {
            "smithy.api#documentation": "Bucket size for the shared time grid. Omit to auto-pick (~60 buckets across the range).\n\n* `second` - second\n* `minute` - minute\n* `minute_5` - minute_5\n* `minute_15` - minute_15\n* `hour` - hour\n* `hour_6` - hour_6\n* `day` - day\n* `week` - week",
            "com.distilled.openapi#nullable": {}
          }
        },
        "clauses": {
          "target": "com.posthog.metrics#MetricQueryBodyClausesList",
          "traits": {
            "smithy.api#documentation": "Full multi-clause form: each clause is an independent metric selection sharing the request's time grid (maximum 10). Mutually exclusive with 'metricName'."
          }
        },
        "formula": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Arithmetic over clause names evaluated server-side per grid point, e.g. '(a - b) / a'. Supports + - * / and parentheses; division by zero yields 0. When set, only the formula result series are returned.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "dateFrom": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Lower bound (inclusive) for the query range. ISO 8601.",
            "smithy.api#required": {}
          }
        },
        "dateTo": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Upper bound (exclusive) for the query range. Defaults to now if omitted."
          }
        }
      },
      "traits": {}
    },
