    "com.posthog.metrics#MetricAnomalyBody": {
      "type": "structure",
      "members": {
        "metricName": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Exact metric name to characterize (e.g. 'metrics_rate_limiter_message_lag_seconds').",
            "smithy.api#required": {}
          }
        },
        "anomalyFrom": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Start of the suspicious window (inclusive). ISO 8601 — e.g. when the alert fired or the graph started looking wrong.",
            "smithy.api#required": {}
          }
        },
        "anomalyTo": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "End of the suspicious window (exclusive). Defaults to now."
          }
        },
        "baselineFrom": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Start of the healthy comparison window. Defaults to one anomaly-window-length before baselineTo."
          }
        },
        "baselineTo": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "End of the healthy comparison window. Defaults to anomalyFrom. Must not extend past anomalyFrom."
          }
        },
        "aggregation": {
          "target": "com.posthog.metrics#AggregationEnum",
          "traits": {
            "smithy.api#documentation": "Aggregation to characterize. Omit to auto-pick from the metric's OTel type (counter -> rate, gauge -> avg, histogram -> histogram_quantile 0.95).\n\n* `sum` - sum\n* `avg` - avg\n* `count` - count\n* `p95` - p95\n* `rate` - rate\n* `increase` - increase\n* `histogram_quantile` - histogram_quantile",
            "com.distilled.openapi#nullable": {}
          }
        },
        "quantile": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "Quantile for histogram_quantile. Defaults to 0.95.",
            "com.distilled.openapi#nullable": {}
          }
        },
        "filters": {
          "target": "com.posthog.metrics#MetricAnomalyBodyFiltersList",
          "traits": {
            "smithy.api#documentation": "Label predicates narrowing which series are characterized."
          }
        },
        "candidateKeys": {
          "target": "com.posthog.metrics#MetricAnomalyBodyCandidateKeysList",
          "traits": {
            "smithy.api#documentation": "Label keys to drill into when finding which label values moved. Omit to auto-discover the most common keys on this metric (plus service_name). Max 4 are used."
          }
        }
      },
      "traits": {}
    },
    "com.posthog.metrics#AggregationEnum": {
      "type": "enum",
