    "com.posthog.saved#HeatmapPreflightResponse": {
      "type": "structure",
      "members": {
        "framing": {
          "target": "com.posthog.saved#FramingEnum",
          "traits": {
            "smithy.api#documentation": "Whether the page can be embedded in the live preview iframe. 'blocked' means the site's own headers forbid it, so only a screenshot or session recording background can work. 'unknown' means we could not tell, for example because the page was unreachable or redirected.\n\n* `allowed` - allowed\n* `blocked` - blocked\n* `unknown` - unknown",
            "smithy.api#required": {}
          }
        },
        "blocked_by": {
          "target": "com.posthog.saved#BlockedByEnum",
          "traits": {
            "smithy.api#documentation": "Which response header forbids embedding, when framing is 'blocked'. Null otherwise.\n\n* `x_frame_options` - x_frame_options\n* `frame_ancestors` - frame_ancestors",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "http_status": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "HTTP status the page returned to us. A 4xx or 5xx here points at the customer's host or CDN rather than at PostHog. Null when the page could not be reached at all.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "body_excerpt": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Short whitespace-collapsed excerpt of the response body, only present for non-2xx responses, so the user can see what their host returned. Truncated.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        }
      },
      "traits": {}
    },
    "com.posthog.saved#FramingEnum": {
      "type": "enum",
      "members": {
        "ALLOWED": {
          "target": "smithy.api#Unit",
          "traits": {
            "smithy.api#enumValue": "allowed"
          }
        },
        "BLOCKED": {
          "target": "smithy.api#Unit",
          "traits": {
            "smithy.api#enumValue": "blocked"
          }
        },
        "UNKNOWN": {
          "target": "smithy.api#Unit",
          "traits": {
            "smithy.api#enumValue": "unknown"
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "* `allowed` - allowed\n* `blocked` - blocked\n* `unknown` - unknown"
      }
    },
    "com.posthog.saved#BlockedByEnum": {
      "type": "enum",
      "members": {
        "X_FRAME_OPTIONS": {
          "target": "smithy.api#Unit",
