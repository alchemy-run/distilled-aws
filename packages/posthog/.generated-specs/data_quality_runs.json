      },
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/api/projects/{project_id}/data_quality_runs/",
          "code": 200
        },
        "smithy.api#documentation": "Project-wide check runs: start one over a selection, and read every run the project has had.\n\nThe per-subject surfaces only serve runs scoped to their own subject, so this is where a sweep\nacross several subjects -- a manual project-wide run, a materialization, a source sync -- is\nreadable. Scoped to `warehouse_objects` because it spans tables and views at once."
      }
    },
