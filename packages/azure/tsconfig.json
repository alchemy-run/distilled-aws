{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    // Cloudflare/AWS pattern (distilled PR #360): generated services carry
    // explicit interfaces + `as any as S.Schema<T>` casts, so checking the
    // 200+ generated ARM service modules buys nothing and costs minutes/GBs.
    "noCheck": true,
    "paths": {
      "@distilled.cloud/core/*": ["../core/src/*"]
    }
  },
  "references": [{ "path": "../core" }]
}
