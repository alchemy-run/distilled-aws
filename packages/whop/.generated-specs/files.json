      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/files",
          "code": 200
        },
        "smithy.api#documentation": "Create File\n\nCreates a file and returns a presigned destination to upload its bytes to. PUT the bytes to `upload_url` (single-part), or to each of `multipart_upload_urls` and then call Complete File Multipart Upload. Once the bytes land the file becomes `ready`, and its ID can be attached wherever a file is accepted — account legal documents, dispute evidence documents."
      }
