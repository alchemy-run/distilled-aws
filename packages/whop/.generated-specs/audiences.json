      },
      "traits": {
        "smithy.api#http": {
          "method": "PATCH",
          "uri": "/audiences/{id}",
          "code": 200
        },
        "smithy.api#documentation": "Update Audience\n\nRenames an audience. For an audience built from People filters that keeps itself up to date, pass `filters` to replace them, which rebuilds membership immediately. Whether an audience auto refreshes is set when it is created."
      }
    },
