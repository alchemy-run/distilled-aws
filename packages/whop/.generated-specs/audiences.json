    "com.whop.audiences#CreateAudienceRequestColumnMapping": {
      "type": "structure",
      "members": {
        "country": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "CSV header for ISO 3166-1 alpha-2 country codes, such as `US`."
          }
        },
        "email": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "CSV header for email addresses."
          }
        },
        "first_name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "CSV header for first names."
          }
        },
        "last_name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "CSV header for last names."
          }
        },
        "ltv": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "CSV header for each customer's lifetime value — a non-negative number, currency symbols allowed. When mapped, Meta creates the audience as value-based, so lookalikes built from it favor people similar to the highest-value customers."
          }
        },
        "phone": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "CSV header for phone numbers."
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "Custom audiences only. Maps supported identity fields to CSV column headers. Map at least one of `email` or `phone`."
      }
    },
    "com.whop.audiences#CreateAudienceRequest": {
      "type": "structure",
      "members": {
        "account_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Account ID, prefixed `biz_`.",
            "smithy.api#required": {}
          }
        },
        "audience_type": {
          "target": "com.whop.audiences#CreateAudienceRequestAudienceType",
          "traits": {
            "smithy.api#documentation": "What to create. Defaults to `custom` (CSV upload)."
          }
        },
        "auto_refresh": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Filter audiences only, and set only at creation. `true` (the default) rebuilds membership from the filters twice a day. `false` keeps whoever matched at creation and never rebuilds."
          }
        },
        "column_mapping": {
          "target": "com.whop.audiences#CreateAudienceRequestColumnMapping",
          "traits": {
            "smithy.api#documentation": "Custom audiences only. Maps supported identity fields to CSV column headers. Map at least one of `email` or `phone`."
          }
        },
        "count": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Lookalikes only. Number of lookalike audiences to create (1–6)."
          }
        },
        "file_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Custom audiences only. The uploaded customer CSV — a file id (`file_...`) returned by `POST /files`."
          }
        },
        "filters": {
          "target": "smithy.api#Document",
          "traits": {
            "smithy.api#documentation": "Filter audiences only. The People filters that define membership, keyed exactly as `GET /people` accepts them — for example `{\"os\": \"iOS\", \"country\": \"US\"}`. Date filters must be rolling windows — `first_seen_within_days` or `last_seen_within_days` — so the audience re-anchors on every refresh; fixed dates such as `first_seen_after` are rejected. Source values are canonical source paths (`whop:<campaign>:<group>:<ad>`, `ext:<platform>:...`, `referrer:<domain>`, `direct`), exact or with a trailing `:*` wildcard."
          }
        },
        "name": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Audience display name. Required for custom audiences; lookalike names are generated from the source audience."
          }
        },
        "percentage": {
          "target": "smithy.api#Integer",
          "traits": {
            "smithy.api#documentation": "Lookalikes only. Total similarity reach as a whole percent (1–20), sliced evenly across `count` — must be divisible by `count`."
          }
        },
        "source_audience_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Lookalikes only. The ready custom audience (`adaud_`) to build from; it needs at least 100 matched people."
          }
        },
        "idempotency_key": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpHeader": "Idempotency-Key",
            "smithy.api#documentation": "A unique key that makes this request safe to retry. See [Idempotent requests](https://docs.whop.com/developer/api/idempotency)."
          }
        }
      },
      "traits": {
        "smithy.api#input": {}
      }
    },
