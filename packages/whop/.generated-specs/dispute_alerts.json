    "com.whop.dispute_alerts#DisputeAlert": {
      "type": "structure",
      "members": {
        "account_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The account the alerted payment belongs to, prefixed `biz_`. `null` while the alert is unmatched.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "actionable": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Whether refunding the payment can still avoid a chargeback. `false` once the payment has been disputed or fully refunded, or when the alert could not be matched to a payment — `not_actionable_reason` says which.",
            "smithy.api#required": {}
          }
        },
        "amount": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "The alerted amount, in whole units of `currency`. This is what the issuer reported, which can differ from the payment's own amount.",
            "smithy.api#required": {}
          }
        },
        "card_brand": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The card network as reported by the issuer, lowercased, such as `visa` or `mastercard`. `unknown` when the report carries neither a network nor a recognizable BIN.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "created_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "When Whop received the alert, as an ISO 8601 timestamp.",
            "smithy.api#required": {}
          }
        },
        "currency": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Three-letter ISO currency code of the alerted amount.",
            "smithy.api#required": {}
          }
        },
        "fee_charged": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#documentation": "Whether Whop charged the account an alert fee for this one. Always `false` for `early_fraud_warning`, which Whop is not billed for and never passes on.",
            "smithy.api#required": {}
          }
        },
        "id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Dispute alert ID, prefixed `dspa_`.",
            "smithy.api#required": {}
          }
        },
        "issuer": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "Name of the bank that issued the card and filed the report.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "not_actionable_reason": {
          "target": "com.whop.dispute_alerts#DisputeAlertNotActionableReason",
          "traits": {
            "smithy.api#documentation": "Why refunding can no longer avoid a chargeback. `network_resolved` when a Visa RDR already closed the case, `payment_unmatched` when no payment matched, `payment_not_captured` when it never captured money, `payment_disputed` once the payment carries a dispute, `payment_refunded` once fully refunded. `null` while `actionable` is true.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "payment_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The payment the issuer reported, prefixed `pay_`. `null` when Whop could not match the report to a payment.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "product_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The product the alerted payment was for, prefixed `prod_`.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "reported_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "When the issuer filed the report, as an ISO 8601 timestamp. Earlier than `created_at`, which is when Whop received it.",
            "smithy.api#required": {}
          }
        },
        "transaction_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "When the reported transaction was made, as an ISO 8601 timestamp.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "type": {
          "target": "com.whop.dispute_alerts#DisputeAlertType",
          "traits": {
            "smithy.api#documentation": "What the issuer sent. `early_fraud_warning` is a fraud report on a settled payment (Visa TC40 / Mastercard SAFE) — refunding still avoids the chargeback, and Whop never charges a fee for one. `dispute_alert` is a pre-dispute notice from the issuer's alert network, which Whop pays for and passes on as a fee. `rapid_dispute_resolution` is a Visa RDR case the network already closed by refunding the payment — nothing is left to act on.",
            "smithy.api#required": {}
          }
        },
        "updated_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "When the alert was last changed, as an ISO 8601 timestamp.",
            "smithy.api#required": {}
          }
        }
      },
      "traits": {}
