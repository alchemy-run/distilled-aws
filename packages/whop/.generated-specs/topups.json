    "com.whop.topups#CreateTopupRequest": {
      "type": "structure",
      "members": {
        "amount": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "The amount to add to the balance in the specified currency. For example, 50.00 for $50.00 USD.",
            "smithy.api#required": {}
          }
        },
        "company_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The unique identifier of the company to add funds to, starting with 'biz_'.",
            "smithy.api#required": {}
          }
        },
        "currency": {
          "target": "com.whop.topups#Currencies",
          "traits": {
            "smithy.api#documentation": "The currency for the top-up amount, such as 'usd'.",
            "smithy.api#required": {}
          }
        },
        "payment_method_id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The unique identifier of the stored payment method to charge for the top-up.",
            "smithy.api#required": {}
          }
        }
      },
      "traits": {
        "smithy.api#input": {}
      }
    },
    "com.whop.topups#Topup": {
      "type": "structure",
      "members": {
        "created_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The datetime the payment was created.",
            "smithy.api#required": {}
          }
        },
        "currency": {
          "target": "com.whop.topups#Currencies",
          "traits": {
            "smithy.api#documentation": "The three-letter ISO currency code for this payment (e.g., 'usd', 'eur').",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "failure_message": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "If the payment failed, the reason for the failure.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The unique identifier for the payment.",
            "smithy.api#required": {}
          }
        },
        "paid_at": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The time at which this payment was successfully collected. Null if the payment has not yet succeeded. As a Unix timestamp.",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "status": {
          "target": "com.whop.topups#ReceiptStatus",
          "traits": {
            "smithy.api#documentation": "The current lifecycle state of this payment (e.g., 'draft', 'open', 'paid', 'void').",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        },
        "total": {
          "target": "smithy.api#Double",
          "traits": {
            "smithy.api#documentation": "The total to show to the creator (excluding buyer fees).",
            "smithy.api#required": {},
            "com.distilled.openapi#nullable": {}
          }
        }
      },
      "traits": {
        "smithy.api#documentation": "A payment represents a completed or attempted charge. Payments track the amount, status, currency, and payment method used."
