{
  "name": "distilled-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "generate": "bun scripts/generate-all.ts",
    "specs:sync": "git submodule sync --recursive && git submodule update --force --init --recursive --depth=1",
    "typecheck": "tsc -b",
    "format": "oxfmt '.'",
    "format:check": "pnpm format -- --check",
    "lint": "oxlint",
    "prepare": "husky",
    "publish:packages": "pnpm publish --recursive --filter './packages/*' --access public",
    "typecheck:ci": "tsc -b --noCheck false"
  },
  "devDependencies": {
    "@types/bun": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "typescript": "catalog:build",
    "husky": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "changelogithub": "^13.16.1"
  },
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": [ {
        "name": "bun",
        "version": "1.3.13",
        "onFail": "warn"
      },
      {
        "name": "node",
        "version": "24",
        "onFail": "warn"
      } ]
  }
}
